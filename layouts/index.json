{{- $results := slice -}}

{{/* 1. Registered apps */}}
{{- range where .Site.Data.apps.apps "searchable" true -}}
    {{- $item := dict
        "title" .title
        "type" .type
        "openWindow" .id
        "description" .description
        "iconHtml" (partial "os/app-icon.html" (dict "app" . "context" "spotlight"))
        "iconHtmlChrome" (partial "os/app-icon.html" (dict "app" . "context" "chrome"))
    -}}
    {{- with .contentPermalink -}}{{- $item = merge $item (dict "permalink" .) -}}{{- end -}}
    {{- with .defaultSize -}}{{- $item = merge $item (dict "width" .width "height" .height) -}}{{- end -}}
    {{- $results = $results | append $item -}}
{{- end -}}

{{/* 2. Content pages */}}
{{- range .Site.RegularPages -}}
    {{- $title := .Title -}}
    {{- $type := .Section -}}
    {{- if eq $type "" }}{{ $type = "page" }}{{ end -}}
    {{- $content := .Plain | truncate 300 -}}
    {{- $prefix := $type -}}
    {{- if eq .Section "blogs" }}{{ $prefix = "post" }}{{ end -}}
    {{- if eq .Section "projects" }}{{ $prefix = "project" }}{{ end -}}
    {{- if eq .Section "timeline" }}{{ $prefix = "timeline" }}{{ end -}}
    {{- $uniqueId := .RelPermalink | urlize -}}
    {{- with .File }}{{ $uniqueId = .UniqueID }}{{ end -}}
    {{- $icon := dict "type" "partial" "partial" "icons/desktop/document.html" -}}
    {{- if eq .Section "projects" }}{{ $icon = dict "type" "partial" "partial" "icons/desktop/folder.html" }}{{ end -}}
    {{- if eq .Section "timeline" }}{{ $icon = dict "type" "partial" "partial" "icons/desktop/calendar.html" }}{{ end -}}

    {{- if not (or (eq $title "Wins") (eq $title "Contact") (eq $title "Schedule Call")) -}}
        {{- $item := dict
            "title" $title
            "type" $type
            "openWindow" (printf "%s-%s" $prefix $uniqueId)
            "permalink" .RelPermalink
            "content" $content
            "width" 900
            "height" 650
            "iconHtml" (partial "os/app-icon.html" (dict "icon" $icon "context" "spotlight"))
            "iconHtmlChrome" (partial "os/app-icon.html" (dict "icon" $icon "context" "chrome"))
        -}}
        {{- $results = $results | append $item -}}
    {{- end -}}
{{- end -}}

{{- $results | jsonify -}}
