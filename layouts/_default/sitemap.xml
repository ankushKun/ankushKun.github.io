{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
  {{- /* Same rule as the robots meta tag: noindex pages stay out. A page
  whose canonical is another site (cross-posted article) stays out too. */ -}}
  {{- if and (partial "seo/indexable.html" .) (not .Params.canonical) }}
  {{- /* A list page is as fresh as its newest entry, not as its _index.md */ -}}
  {{- $lastmod := .Lastmod -}}
  {{- if not .IsPage -}}
  {{- $children := .RegularPagesRecursive -}}
  {{- if .IsHome }}{{ $children = site.RegularPages }}{{ end -}}
  {{- range $children }}{{ if .Lastmod.After $lastmod }}{{ $lastmod = .Lastmod }}{{ end }}{{ end -}}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not $lastmod.IsZero }}
    <lastmod>{{ safeHTML ( $lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
    {{- if .IsHome }}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    {{- else if .IsSection }}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    {{- else if eq .Section "blogs" }}
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
    {{- else if eq .Section "projects" }}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {{- else }}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
