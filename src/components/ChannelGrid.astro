---
// The Wii's channel menu, for /apps/ and /games/: each channel wide in a glossy frame, its art edge
// to edge and its name across the top; whole pages of twelve, with empty CRT-striped slots filling
// the page. Pointing at a channel previews its description in the Mii info bar underneath. A
// channel without an href is not ready yet: it shakes its head when pressed.
export interface Channel {
  id: string;
  label: string;
  description: string;
  href?: string;
  /** Wide art, 560 by 315. */
  art?: string;
  /** Art painted for the channel on white (dark name), rather than a crop of busy art (white name). */
  banner?: boolean;
  /** Opens, but to a placeholder: shows the Soon tag and a quieter picture. */
  soon?: boolean;
  /** Opens an app that grows out of the channel (see motion.ts). */
  grow?: boolean;
}

interface Props {
  channels: Channel[];
  /** What the info bar says until a channel is pointed at. */
  hint: { title: string; text: string };
}

const { channels: list, hint } = Astro.props;
const PAGE = 12;
const channels = list.map((c) => ({ ...c, painted: Boolean(c.art) && !c.banner }));
const empty = Math.ceil(Math.max(channels.length, 1) / PAGE) * PAGE - channels.length;
---

<div class="menu">
    <ul class="grid" data-app-grid>
      {
        channels.map((app) => (
          <li id={app.id}>
            {app.href ? (
              <a
                href={app.href}
                class:list={['channel', app.soon ? 'is-soon' : 'is-live', app.painted && 'is-painted', app.banner && 'is-banner']}
                data-grow={app.grow ? '' : undefined}
                data-app-label={app.label}
                data-app-desc={app.description}
                data-sfx
              >
                {app.art && <img class="art" src={app.art} alt="" width="560" height="315" decoding="async" />}
                <span class="name">{app.label}</span>
                {app.soon && <span class="status soon">Soon</span>}
              </a>
            ) : (
              <button
                type="button"
                class:list={['channel', 'is-soon', app.painted && 'is-painted', app.banner && 'is-banner']}
                aria-disabled="true"
                aria-describedby={`${app.id}-desc`}
                data-app-label={app.label}
                data-app-desc={app.description}
                data-sfx="nope"
              >
                {app.art && <img class="art" src={app.art} alt="" width="560" height="315" decoding="async" />}
                <span class="name">{app.label}</span>
                <span class="status soon">Soon</span>
                <span id={`${app.id}-desc`} class="sr-only">
                  {app.description} Not ready yet.
                </span>
              </button>
            )}
          </li>
        ))
      }
      {Array.from({ length: empty }, () => <li class="slot" aria-hidden="true"><span /></li>)}
    </ul>

    <aside class="mii-note channel-bar" aria-live="polite" data-channel-bar>
      <img src="/mii/me-happy.webp" alt="" width="112" height="112" data-channel-mii />
      <div class="bubble">
        <strong data-channel-title>{hint.title}</strong>
        <span data-channel-desc>{hint.text}</span>
      </div>
    </aside>
  </div>

<script>
  function wireAppsMenu() {
    const grid = document.querySelector<HTMLElement>('[data-app-grid]');
    const bar = document.querySelector<HTMLElement>('[data-channel-bar]');
    if (!grid || !bar || grid.dataset.wired) return;
    grid.dataset.wired = '1';

    const titleEl = bar.querySelector<HTMLElement>('[data-channel-title]');
    const descEl = bar.querySelector<HTMLElement>('[data-channel-desc]');
    const miiEl = bar.querySelector<HTMLImageElement>('[data-channel-mii]');

    const preview = (el: HTMLElement, shocked = false) => {
      const label = el.dataset.appLabel;
      const desc = el.dataset.appDesc;
      if (!label || !desc || !titleEl || !descEl || !miiEl) return;
      const soon = el.classList.contains('is-soon');
      titleEl.textContent = shocked ? `${label} is still warming up!` : soon ? `${label} (Coming soon)` : label;
      descEl.textContent = shocked ? `${desc} Still building this channel for the new TV.` : desc;
      miiEl.src = shocked ? '/mii/me-surprised.webp' : '/mii/me-happy.webp';
    };

    grid.addEventListener('pointerover', (e) => {
      const ch = e.target instanceof Element ? e.target.closest<HTMLElement>('.channel') : null;
      if (ch) preview(ch, false);
    });
    grid.addEventListener('focusin', (e) => {
      const ch = e.target instanceof Element ? e.target.closest<HTMLElement>('.channel') : null;
      if (ch) preview(ch, false);
    });
    grid.addEventListener('click', (e) => {
      const app = e.target instanceof Element ? e.target.closest<HTMLElement>('.channel[aria-disabled="true"]') : null;
      if (!app) return;
      preview(app, true);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      app.animate(
        [{ translate: '0' }, { translate: '-7px 0' }, { translate: '7px 0' }, { translate: '-5px 0' }, { translate: '4px 0' }, { translate: '0' }],
        { duration: 420, easing: 'ease-out' },
      );
    });
  }
  document.addEventListener('astro:page-load', wireAppsMenu);
</script>

<style>
  /* Columns follow the room the menu has, not the window. */
  .menu {
    container-type: inline-size;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 540px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container (min-width: 780px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  li {
    scroll-margin-top: 40px;
  }

  /* A channel: wide, in a glossy white frame, with a sheen across the top of its glass. */
  .channel,
  .slot {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 4px;
    border: 0;
    border-radius: 18px;
    background: linear-gradient(to bottom, var(--color-gloss-top), var(--color-gloss-bottom));
    box-shadow:
      inset 0 0 0 1px light-dark(rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.08)),
      0 0 0 1px light-dark(rgb(40 60 70 / 0.16), rgb(0 0 0 / 0.6)),
      0 4px 10px -5px light-dark(rgb(30 50 60 / 0.3), rgb(0 0 0 / 0.6));
  }

  .channel {
    container-type: inline-size;
    color: #fff;
    font: inherit;
    text-decoration: none;
    transition:
      box-shadow 0.18s ease,
      scale 0.35s var(--ease-spring),
      filter 0.18s ease;
  }

  .channel.is-soon .art {
    filter: saturate(0.72) brightness(0.92);
  }

  .channel.is-soon:hover .art {
    filter: saturate(0.9) brightness(0.98);
  }

  .channel::after {
    content: '';
    position: absolute;
    inset: 4px 4px 50%;
    border-radius: 14px 14px 40% 40% / 14px 14px 18% 18%;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.32), rgb(255 255 255 / 0.04));
    pointer-events: none;
  }

  .channel:hover,
  .channel:focus-visible {
    scale: 1.04;
    box-shadow:
      var(--glow),
      0 10px 20px -8px light-dark(rgb(30 50 60 / 0.4), rgb(0 0 0 / 0.6));
  }

  .channel:active {
    scale: 0.98;
    transition-duration: 0.08s;
  }

  .art {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    object-fit: cover;
  }

  /* Painted art is busy, so a soft shade at its top keeps the name readable. */
  .is-painted::before {
    content: '';
    position: absolute;
    inset: 4px 4px 50%;
    border-radius: 14px 14px 0 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.48), transparent);
    pointer-events: none;
  }

  /* The name across the top, white with a soft dark edge, as the Wii lettered its channels. */
  .name {
    position: absolute;
    top: 9%;
    right: 8px;
    left: 8px;
    overflow: hidden;
    font-size: clamp(0.75rem, 8.5cqi, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    text-align: center;
    text-overflow: ellipsis;
    text-shadow:
      0 0 2px rgb(0 0 0 / 0.65),
      0 1px 4px rgb(0 0 0 / 0.55);
    white-space: nowrap;
  }

  /* A banner painted for its channel is white, so its name is grey, as the Wii lettered its own. */
  .is-banner .name {
    color: #46545c;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.9);
  }

  .status {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: 99px;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.35);
  }

  .status.soon {
    background: rgb(24 30 34 / 0.72);
    backdrop-filter: blur(4px);
    color: rgb(255 255 255 / 0.88);
  }

  /* A slot with no channel yet: grey, finely striped, softly lit from inside. */
  .slot span {
    display: block;
    height: 100%;
    border-radius: 14px;
    background: repeating-linear-gradient(
      to bottom,
      light-dark(#eef0f1, #262c30) 0 2px,
      light-dark(#e4e7e9, #22282b) 2px 4px
    );
    box-shadow: inset 0 0 22px light-dark(rgb(255 255 255 / 0.85), rgb(0 0 0 / 0.35));
  }

  .channel-bar {
    margin-top: 22px;
  }

  .channel-bar .bubble {
    display: grid;
    gap: 2px;
  }

  .channel-bar strong {
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .channel-bar span {
    color: var(--color-ink-soft);
    font-size: 0.875rem;
  }

  /* Arriving from its block on the plaza, an app says hello. */
  li:target .channel {
    animation: hello 1.1s var(--ease-spring) 0.5s both;
  }

  @keyframes hello {
    30% {
      scale: 1.1;
    }
    55% {
      scale: 0.97;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    li:target .channel {
      animation: none;
    }
  }
</style>
