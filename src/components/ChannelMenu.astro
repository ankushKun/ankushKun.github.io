---
// Entries as channels on the console's menu: art in a glossy frame with the name under it, two
// across the column or more as it widens, newest first.
import Thumb from './ui/Thumb.astro';
import { urlOf, type Entry } from '../lib/content';

interface Props {
  items: Entry[];
  /** How many pictures are on screen as the page opens: those load at once, the rest when near. */
  eager?: number;
  /** Larger 2-up featured shelf with descriptions. */
  featured?: boolean;
  /** Enable data-categories attributes for client-side filtering on /projects/. */
  filterable?: boolean;
  /** Show a subtle section label pill (Blog / Project / Timeline) for mixed cross-section lists. */
  showKind?: boolean;
}

const { items, eager = 6, featured = false, filterable = false, showKind = false } = Astro.props;

const KIND_LABEL: Record<Entry['collection'], string> = {
  blog: 'Blog',
  projects: 'Project',
  timeline: 'Timeline',
};

function categoriesFor(entry: Entry): string[] {
  const tags = new Set(entry.data.tags);
  const cats = new Set<string>();
  if (tags.has('ai-agents') || tags.has('machine-learning') || tags.has('construct')) cats.add('ai');
  if (tags.has('game-dev') || tags.has('handheld') || tags.has('pokemon') || tags.has('tcg') || tags.has('doom')) cats.add('games');
  if (tags.has('web3') || tags.has('arweave') || tags.has('ao') || tags.has('solana')) cats.add('web3');
  if (tags.has('hardware')) cats.add('hardware');
  if (tags.has('developer-tools') || tags.has('web') || tags.has('cloudflare') || tags.has('productivity')) cats.add('tools');
  if (entry.collection === 'projects' && entry.data.status === 'archived') cats.add('archived');
  if (cats.size === 0) cats.add('tools');
  return [...cats];
}
---

<ul class:list={['channels', { 'is-featured': featured }]}>
  {
    items.map((entry, i) => {
      const archived = entry.collection === 'projects' && entry.data.status === 'archived';
      const cats = filterable ? categoriesFor(entry).join(' ') : undefined;
      return (
        <li data-cats={cats}>
          <a href={urlOf(entry)} class="channel" data-sfx>
            <span class="glass">
              <Thumb {entry} width={featured ? 640 : 480} class="art" eager={i < eager} />
              {showKind && <span class={`badge-kind is-${entry.collection}`}>{KIND_LABEL[entry.collection]}</span>}
              {archived && !featured && !showKind && <span class="badge-archived">Archived</span>}
              {!archived && (
                <span class="new-tag" data-new={urlOf(entry)} hidden>
                  New
                </span>
              )}
            </span>
            <span class="info">
              <span class="name">{entry.data.title}</span>
              {featured && <span class="summary">{entry.data.description}</span>}
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
    gap: 18px;
  }

  .channels.is-featured {
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }

  .channels li[hidden] {
    display: none;
  }

  .channel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 7px 7px 0;
    border-radius: 20px;
    background: linear-gradient(
      to bottom,
      var(--color-gloss-top) 0%,
      light-dark(#f3f4f5, #30373b) 48%,
      light-dark(#e9ecee, #292f33) 52%,
      light-dark(#f1f2f3, #2c3236) 100%
    );
    box-shadow:
      var(--rim),
      inset 0 1px 0 light-dark(#fff, rgb(255 255 255 / 0.08)),
      0 3px 8px -3px light-dark(rgb(30 50 60 / 0.22), rgb(0 0 0 / 0.5));
    color: inherit;
    text-decoration: none;
    transition:
      translate 0.3s var(--ease-spring),
      box-shadow 0.18s ease;
  }

  .channel:hover,
  .channel:focus-visible {
    translate: 0 -2px;
    box-shadow:
      var(--glow),
      0 10px 22px -10px light-dark(rgb(30 50 60 / 0.4), rgb(0 0 0 / 0.6));
  }

  .channel:active {
    translate: 0 0;
    transition-duration: 0.08s;
  }

  .glass {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 15px / 19px;
  }

  .glass :global(.art) {
    aspect-ratio: 16 / 9;
    border-radius: inherit;
  }

  /* A little gloss across the top of the art, as on the console's channels. */
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.2), transparent 42%);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
    pointer-events: none;
  }

  .badge-archived,
  .badge-kind {
    position: absolute;
    top: 8px;
    z-index: 2;
    padding: 1px 8px;
    border-radius: 99px;
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .glass .new-tag {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 2;
  }

  .badge-archived {
    right: 8px;
    background: rgb(25 32 36 / 0.72);
  }

  .badge-kind {
    left: 8px;
    background: rgb(25 32 36 / 0.74);
  }

  .badge-kind.is-blog {
    background: rgb(228 74 79 / 0.9);
  }

  .badge-kind.is-projects {
    background: rgb(28 111 208 / 0.9);
  }

  .badge-kind.is-timeline {
    background: rgb(31 148 87 / 0.9);
  }

  .info {
    display: grid;
    gap: 4px;
    padding: 9px 10px 11px;
  }

  .name {
    display: block;
    overflow: hidden;
    color: var(--color-ink-strong);
    font-size: 0.875rem;
    font-weight: 700;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .is-featured .info {
    padding: 11px 12px 14px;
  }

  .is-featured .name {
    font-size: 1rem;
    font-weight: 800;
    text-align: left;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 479px) {
    .channels:not(.is-featured) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .channel {
      padding: 5px 5px 0;
      border-radius: 16px;
    }

    .name {
      font-size: 0.8125rem;
    }
  }
</style>
