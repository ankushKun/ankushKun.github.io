---
// Your Mii on a small stage, waving. Loads the Mii runtime only where JavaScript and data allow;
// coming from the plaza it is already loaded.
import { AUTHOR } from '../../site';
import { LOOKS, ME } from '../../data/plaza';
import { resolveMii } from '../../lib/miis';

const code = await resolveMii(ME, 'ME');
---

<div class="stage" data-mii-stage={code} data-left-eye={LOOKS[ME]?.leftEye}>
  <span class="stage-disc" aria-hidden="true"></span>
  <canvas role="img" aria-label={`${AUTHOR.name.split(' ')[0]}'s Mii`}></canvas>
</div>

<script>
  import { mountStage } from './stage';

  let stop: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-mii-stage]');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (!root || saveData || root.dataset.live !== undefined) return;
    root.dataset.live = '';
    stop = mountStage(root, root.dataset.miiStage ?? '', { leftEye: root.dataset.leftEye });
  });
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>

<style>
  .stage {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 20px;
    background:
      radial-gradient(90% 60% at 50% 25%, light-dark(#fff, rgb(255 255 255 / 0.1)) 0%, transparent 70%),
      linear-gradient(to bottom, light-dark(#f3f9fa, #2a3337), light-dark(#dceaed, #1f272b));
  }

  .stage-disc {
    position: absolute;
    bottom: 9%;
    left: 50%;
    width: 64%;
    height: 14%;
    border-radius: 50%;
    background: radial-gradient(closest-side, light-dark(rgb(60 90 100 / 0.22), rgb(0 0 0 / 0.45)), transparent);
    translate: -50% 0;
  }

  canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    scale: 0.9;
    cursor: pointer;
    transition:
      opacity 0.4s ease,
      scale 0.7s var(--ease-spring);
  }

  .stage[data-ready] canvas {
    opacity: 1;
    scale: 1;
  }
</style>
