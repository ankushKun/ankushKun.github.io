---
// Loads a Mii from a QR code image or a Mii code and shows it in 3D. Starts on your Mii.
import { ME } from '../../data/plaza';
import { resolveMii } from '../../lib/miis';

const initial = await resolveMii(ME, 'ME');
---

<div class="mii" data-mii data-initial={initial}>
  <div class="mii-stage" data-stage>
    <canvas role="img" aria-label="Mii preview"></canvas>
    <p class="mii-name" data-name></p>
  </div>
  <div class="mii-bar">
    <label class="mii-button">
      QR code
      <input type="file" accept="image/*" class="sr-only" data-file />
    </label>
    <input data-code aria-label="Mii code" spellcheck="false" autocomplete="off" />
    <button type="button" class="mii-button" data-copy>Copy</button>
  </div>
  <p class="mii-status" data-status role="status"></p>
  <noscript>This page needs JavaScript.</noscript>
</div>

<script>
  // Pages change in place, so the viewer starts on each visit and stops when you leave.
  let stopping: Promise<() => void> | null = null;
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-mii]');
    if (!root || root.dataset.live !== undefined) return;
    root.dataset.live = '';
    stopping = import('./viewer').then(({ mount }) => mount(root));
  });
  document.addEventListener('astro:before-swap', () => {
    stopping?.then((stop) => stop());
    stopping = null;
  });
</script>

<style is:global>
  .mii {
    --mii-line: light-dark(rgb(29 40 38 / 0.12), rgb(255 255 255 / 0.14));
    --mii-ink: light-dark(#1d2826, #e3ece9);
    display: grid;
    gap: 12px;
  }

  .mii-stage {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: radial-gradient(
      120% 90% at 50% 20%,
      light-dark(#ffffff, #33403d) 0%,
      light-dark(#e6f2ef, #253230) 55%,
      light-dark(#cfe1dc, #1a2422) 100%
    );
    aspect-ratio: 4 / 3;
    transition: box-shadow 0.15s ease;
  }

  .mii-stage[data-drop] {
    box-shadow: inset 0 0 0 3px #3caade;
  }

  .mii-stage canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }

  .mii-stage canvas:active {
    cursor: grabbing;
  }

  .mii-name {
    position: absolute;
    left: 16px;
    top: 12px;
    margin: 0;
    padding: 4px 12px;
    border-radius: 999px;
    background: #4a4f55;
    color: #fff;
    font-weight: 700;
    font-size: 14px;
  }

  .mii-name:empty {
    display: none;
  }

  .mii-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mii-button {
    flex: none;
    padding: 6px 14px;
    border: 1px solid var(--mii-line);
    border-radius: 999px;
    font-weight: 600;
    cursor: pointer;
  }

  .mii-bar input[data-code] {
    flex: 1 1 200px;
    min-width: 0;
    padding: 6px 12px;
    border: 1px solid var(--mii-line);
    border-radius: 999px;
    font-family: ui-monospace, monospace;
    font-size: 13px;
  }

  .mii-bar input[aria-invalid='true'] {
    border-color: #d8262e;
  }

  .mii-status {
    min-height: 1.5em;
    margin: 0;
    font-size: 14px;
  }

  .mii-status[data-error] {
    color: #d8262e;
  }

  .mii :focus-visible,
  .mii-button:focus-within {
    outline: 3px solid #3caade;
    outline-offset: 2px;
  }
</style>
