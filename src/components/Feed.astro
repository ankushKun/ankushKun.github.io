---
// The blog: every post as a row to read down the column, newest first, under its year. The
// picture flies to the post's own page when one is opened (see src/scripts/motion.ts).
import Thumb from './ui/Thumb.astro';
import { byYear, formatDate, isoDate, readingMinutes, urlOf, type Entry } from '../lib/content';

interface Props {
  items: Entry[];
}

/** The first rows, on screen as the page opens: their pictures load at once, the rest when near. */
const EAGER = 6;
let row = 0;

const day = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<div class="feed">
  {
    byYear(Astro.props.items).map(([year, posts]) => (
      <section>
        <h2 class="year">{year}</h2>
        <ol>
          {posts.map((post) => (
            <li>
              <a href={urlOf(post)} class="row" data-sfx>
                <Thumb entry={post} width={320} class="art" eager={row++ < EAGER} />
                <span class="text">
                  <span class="title">{post.data.title}</span>
                  <span class="meta">
                    <time datetime={isoDate(post.data.date)} title={formatDate(post.data.date, 'long')}>
                      {day(post.data.date)}
                    </time>
                    {` · ${readingMinutes(post)} min`}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .year {
    margin: 30px 0 6px;
    color: var(--color-ink-faint);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  section:first-child .year {
    margin-top: 0;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 -14px;
    padding: 12px 14px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  .row:hover,
  .row:focus-visible {
    background: var(--color-raise);
    box-shadow: var(--glow);
  }

  .row :global(.art) {
    flex: none;
    width: 132px;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
  }

  .text {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .title {
    color: var(--color-ink-strong);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .meta {
    color: var(--color-ink-quiet);
    font-size: 0.8125rem;
  }

  @media (max-width: 479px) {
    .row {
      gap: 14px;
      margin: 0 -10px;
      padding: 10px;
    }

    .row :global(.art) {
      width: 104px;
    }

    .title {
      font-size: 0.9375rem;
    }
  }
</style>
