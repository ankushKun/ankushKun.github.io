---
// Entries grouped under a heading per year, newest first.
import EntryList from './EntryList.astro';
import { byYear, type Entry } from '../lib/content';

interface Props {
  items: Entry[];
}

const groups = byYear(Astro.props.items);
---

{
  groups.map(([year, items]) => (
    <section class="mb-10">
      <h2 class="mb-4 text-xl font-semibold">{year}</h2>
      <EntryList items={items} />
    </section>
  ))
}
