---
// One note on the Guestbook's board, as the page is built from the snapshot. main.ts draws the
// same markup (noteEl) for notes that arrive while you're there; keep the two alike.
import type { Entry } from './entry';
import { badgeFor } from './links';
import { dateOf, lookOf } from './look';

interface Props {
  entry: Entry;
}

const { entry: e } = Astro.props;
const look = lookOf(e);
const links = e.links.map(badgeFor);
---

<li class="note" data-id={e.id} data-ts={e.ts} data-updated={e.updatedTs} data-paper={look.paper} style={`--tilt:${look.tilt}`}>
  <span class="note-pin" data-pin={look.pin} aria-hidden="true"></span>
  <div class="note-paper">
    <div class="note-sheet">
      {e.blurb ? <p class="note-text">{e.blurb}</p> : !e.doodle && <p class="note-sig">{e.name}</p>}
    </div>
    {e.doodle && <img class="note-doodle" src={e.doodle} alt={`Drawing by ${e.name}`} width="320" height="240" decoding="async" loading="lazy" />}
  </div>
  <footer class="note-foot">
    <span class="face" data-uuid={e.uuid || undefined} data-seed={e.uuid || e.id}><img alt="" /></span>
    <div class="note-who">
      <b>{e.name}</b>
      {e.from && <span>{e.from}</span>}
    </div>
    {
      links.length > 0 && (
        <span class="note-links">
          {links.map((b) => (
            <a class:list={['note-link', b.email && 'ph-no-capture']} href={b.href} rel="noopener nofollow ugc" target="_blank" aria-label={`${e.name} on ${b.label}`} title={b.short}>
              <span class="gb-badge" style={`--badge-bg:${b.bg};color:${b.ink}`} aria-hidden="true">
                <svg viewBox="0 0 24 24" width="13" height="13">
                  {b.stroke ? <path d={b.path} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" /> : <path d={b.path} fill="currentColor" />}
                </svg>
              </span>
            </a>
          ))}
        </span>
      )
    }
    <time datetime={new Date(e.ts || e.updatedTs).toISOString()}>{dateOf(e.ts || e.updatedTs)}</time>
  </footer>
</li>
