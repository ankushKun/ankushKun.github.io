---
// Your profiles elsewhere, as a Wii U friend roster: one link button each, its platform's real mark.
import MenuButton from './ui/MenuButton.astro';
import { SOCIALS } from '../site';
---

<ul class="roster">
  {
    SOCIALS.map((s) => (
      <li>
        <MenuButton href={s.url} label={s.platform} rel="me" />
      </li>
    ))
  }
</ul>

<style>
  .roster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }

  .roster li {
    min-width: 0;
  }
</style>
