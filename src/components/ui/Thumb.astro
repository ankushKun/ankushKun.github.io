---
// An entry's picture: its cover, or drawn art when it has none. `main` is the entry page's own copy,
// which carries the alt text.
import { Image } from 'astro:assets';
import type { Entry } from '../../lib/content';
import { artPath } from '../../lib/tiles';

interface Props {
  entry: Entry;
  width?: number;
  main?: boolean;
  eager?: boolean;
  class?: string;
}

const { entry, width = 480, main = false, eager = false, class: className } = Astro.props;
const { cover, coverAlt, title } = entry.data;
const alt = main ? coverAlt || title : '';
---

<div class:list={['thumb', className]}>
  {
    cover ? (
      <Image
        src={cover}
        {alt}
        width={width}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <img src={artPath(entry)} {alt} width={width} height={width} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    )
  }
</div>
