---
// An entry's picture: its cover, or drawn art when it has none. `main` is the entry page's own copy,
// which carries the alt text. A cover.dark.* beside the cover is shown instead in the dark theme;
// the cover itself stays what social previews get.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Entry } from '../../lib/content';
import { artPath } from '../../lib/tiles';

interface Props {
  entry: Entry;
  width?: number;
  main?: boolean;
  eager?: boolean;
  class?: string;
}

const { entry, width = 480, main = false, eager = false, class: className } = Astro.props;
const { cover, coverAlt, title } = entry.data;
const alt = main ? coverAlt || title : '';

const DARK = import.meta.glob<ImageMetadata>('/src/content/*/*/cover.dark.{webp,jpg,jpeg,png,avif}', { eager: true, import: 'default' });
const dark = cover && Object.entries(DARK).find(([path]) => path.startsWith(`/src/content/${entry.collection}/${entry.id}/`))?.[1];
const imageProps = { width, loading: eager ? ('eager' as const) : ('lazy' as const), fetchpriority: eager ? ('high' as const) : undefined, decoding: 'async' as const };
---

<div class:list={['thumb', className]}>
  {
    cover ? (
      <>
        <Image src={cover} {alt} class={dark ? 'light-only' : undefined} {...imageProps} />
        {dark && <Image src={dark} {alt} class="dark-only" {...imageProps} />}
      </>
    ) : (
      <img src={artPath(entry)} {alt} width={width} height={Math.round((width * 9) / 16)} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    )
  }
</div>
