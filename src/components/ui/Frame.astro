---
// The TV every page but the plaza is shown on: a casing around a rounded screen (white, or black
// in the dark), a round button back to the plaza in the top left corner and one in the top right
// that opens the menu of sections. It is the same element across page changes (Base.astro persists
// it), so it never flickers; src/scripts/motion.ts moves the menu's marker and closes it as you go.
import { Cancel01Icon, DashboardSquare01Icon, Home01Icon } from '@hugeicons/core-free-icons';
import HugeIcon from './HugeIcon.astro';
import { NAV } from '../../site';
import { sectionOf } from '../../lib/nav';
import { tileFor } from '../../lib/tiles';

const here = sectionOf(Astro.url.pathname);
const items = NAV.map((l) => ({ ...l, tile: tileFor(l.href) }));
---

<div class="tv" data-frame transition:persist="frame">
  <div class="tv-glass" aria-hidden="true"></div>
  <a href="/#0" class="tv-btn tv-home" aria-label="Plaza" data-sfx="back">
    <HugeIcon icon={Home01Icon} strokeWidth={1.9} />
  </a>
  <button type="button" class="tv-btn tv-open" popovertarget="tv-menu" aria-label="Menu" data-sfx>
    <HugeIcon icon={DashboardSquare01Icon} strokeWidth={1.9} class="grid" />
    <HugeIcon icon={Cancel01Icon} strokeWidth={2.1} class="close" />
  </button>
  <nav id="tv-menu" class="tv-menu" popover="manual" aria-label="Sections">
    {
      items.map((item) => (
        <a
          href={item.href}
          class="tv-item"
          aria-current={sectionOf(item.href) === here ? 'page' : undefined}
          data-sfx
        >
          <span class="tv-name">{item.label}</span>
          <span class="tv-tile">{item.tile && <img src={item.tile.src} alt="" width="104" height="104" decoding="async" />}</span>
        </a>
      ))
    }
  </nav>
</div>

<style is:global>
  /* The casing: an opaque frame round the screen, so the page scrolls under its edge as under glass.
     It's drawn inside its own box, as a thick border on an element reaching past the window on every
     side, the border's inner edge being the screen's rounded edge; the rim and the glass's shade are
     inset shadows inside it. Not a shadow spread outward: iOS WebKit doesn't reliably paint a fixed
     element's shadow outside its box, and the page showed through above and below the screen.
     motion.ts and play.ts measure the screen as the box less its border. */
  .tv-glass {
    /* How far past the window it reaches: beyond the curve of its outer corners. */
    --reach: 200px;
    --rx: var(--crt-x);
    --ry: var(--crt-y);
    --bt: calc(var(--bezel-top) + var(--reach));
    --bs: calc(var(--bezel) + var(--reach));
    --bb: calc(var(--bezel-bottom) + var(--reach));
    position: fixed;
    z-index: 40;
    inset: calc(-1 * var(--reach));
    box-sizing: border-box;
    border-style: solid;
    border-color: var(--color-casing);
    border-width: var(--bt) var(--bs) var(--bb);
    /* Outer radius = the screen's corner radius plus the border, so the inner edge has the screen's. */
    border-radius: calc(var(--rx) + var(--bs)) calc(var(--rx) + var(--bs)) calc(var(--rx) + var(--bs)) calc(var(--rx) + var(--bs)) / calc(var(--ry) + var(--bt)) calc(var(--ry) + var(--bt)) calc(var(--ry) + var(--bb)) calc(var(--ry) + var(--bb));
    box-shadow:
      inset 0 0 0 1.5px light-dark(rgb(10 30 50 / 0.14), rgb(0 0 0 / 0.7)),
      inset 0 0 18px light-dark(rgb(10 40 70 / 0.1), rgb(0 0 0 / 0.55));
    pointer-events: none;
    contain: layout style;
    view-transition-name: tv-glass;
    transition:
      border-width 0.45s var(--ease-glide),
      border-radius 0.45s var(--ease-glide),
      box-shadow 0.45s ease;
  }

  /* An app has the whole screen: the casing slides off past the edges, and back when you leave. */
  html:has(.col-app) .tv-glass {
    --rx: 0px;
    --ry: 0px;
    box-shadow:
      inset 0 0 0 1.5px transparent,
      inset 0 0 18px transparent;
  }

  .tv-btn {
    position: fixed;
    z-index: 50;
    top: calc(var(--bezel-top) + 22px);
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, var(--color-gloss-top) 40%, light-dark(#eaeff1, #262c30));
    box-shadow:
      0 0 0 3px light-dark(#a8def4, #2a6d8e),
      0 4px 10px -4px light-dark(rgb(30 50 60 / 0.3), rgb(0 0 0 / 0.6));
    color: light-dark(#8a9499, #a3b0b6);
    transition:
      box-shadow 0.18s ease,
      color 0.18s ease,
      scale 0.3s var(--ease-spring),
      translate 0.35s var(--ease-glide),
      top 0.35s var(--ease-glide),
      opacity 0.25s ease;
  }

  /* The glass's gloss, over its top half. */
  .tv-tile::after {
    content: '';
    position: absolute;
    inset: 1px 1px 50%;
    border-radius: 28% 28% 50% 50% / 34% 34% 12% 12%;
    background: var(--aero-gloss);
    opacity: 0.55;
    pointer-events: none;
  }

  .tv-btn:hover,
  .tv-btn:focus-visible,
  .tv-open:has(+ .tv-menu:popover-open:not([data-closing])) {
    color: var(--color-sky);
    box-shadow:
      var(--glow),
      0 4px 10px -4px light-dark(rgb(30 50 60 / 0.3), rgb(0 0 0 / 0.6));
  }

  .tv-btn:active {
    scale: 0.92;
    transition-duration: 0.08s;
  }

  .tv-btn svg {
    width: 24px;
    height: 24px;
  }

  .tv-home {
    left: calc(var(--bezel) + 26px);
    view-transition-name: tv-home;
  }

  .tv-open {
    right: calc(var(--bezel) + 26px);
    view-transition-name: tv-open;
  }

  /* The menu button's grid turns into a cross while the menu is open, and back. */
  .tv-open svg {
    grid-area: 1 / 1;
    width: 22px;
    height: 22px;
    transition:
      opacity 0.16s ease,
      rotate 0.32s var(--ease-spring),
      scale 0.32s var(--ease-spring);
  }

  .tv-open .close {
    opacity: 0;
    rotate: -90deg;
    scale: 0.6;
  }

  .tv-open:has(+ .tv-menu:popover-open:not([data-closing])) .grid {
    opacity: 0;
    rotate: 90deg;
    scale: 0.6;
  }

  .tv-open:has(+ .tv-menu:popover-open:not([data-closing])) .close {
    opacity: 1;
    rotate: 0deg;
    scale: 1;
  }

  /* The menu of sections: its tiles drop out of the button one under another, each with its name
     to its left, and fold back up into it in turn (src/scripts/menu.ts). It stays until
     the button (or Escape) closes it. */
  .tv-menu {
    --tile: 52px;
    position: fixed;
    inset: auto;
    top: calc(var(--bezel-top) + 22px + 56px + 14px);
    right: calc(var(--bezel) + 28px);
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: visible;
    background: none;
    color: #fff;
    /* Above the column while pages change, as the buttons are. */
    view-transition-name: tv-menu;
  }

  .tv-menu:popover-open {
    display: flex;
  }

  /* The page stays as it is behind it, and can be used with the menu open. */
  .tv-menu::backdrop {
    display: none;
  }

  /* Each item drops out of the button and folds back into it (src/scripts/menu.ts). */
  .tv-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
    transform-origin: calc(100% - var(--tile) / 2) 50%;
  }

  .tv-item:focus-visible {
    box-shadow: none;
  }

  /* The name, as plain text: stronger when pointed at, blue for the section you are in and while
     pressed. A soft glow of the screen behind it keeps it readable over the page. */
  .tv-name {
    color: var(--color-ink-mid);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 30px;
    white-space: nowrap;
    text-shadow:
      0 0 2px var(--color-screen),
      0 0 8px var(--color-screen);
    transition: color 0.18s ease;
  }

  .tv-item:hover .tv-name,
  .tv-item:focus-visible .tv-name {
    color: var(--color-ink-strong);
  }

  .tv-item[aria-current] .tv-name,
  .tv-item:active .tv-name {
    color: #1f9fdb;
  }

  .tv-tile {
    position: relative;
    flex: none;
    width: var(--tile);
    height: var(--tile);
    padding: 5px;
    border-radius: 28%;
    background: var(--aero-bg);
    box-shadow: var(--aero-shadow);
    backdrop-filter: blur(10px) saturate(1.4);
    transition:
      box-shadow 0.18s ease,
      scale 0.3s var(--ease-spring);
  }

  .tv-item:hover .tv-tile,
  .tv-item:focus-visible .tv-tile {
    scale: 1.08;
    box-shadow:
      var(--glow),
      var(--aero-shadow);
  }

  .tv-item:active .tv-tile {
    scale: 0.96;
    transition-duration: 0.08s;
  }

  .tv-tile img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 22%;
    object-fit: cover;
    box-shadow: 0 0 0 1px light-dark(rgb(60 90 105 / 0.18), rgb(0 0 0 / 0.4));
  }

  /* A phone: a thinner casing, and smaller buttons that step aside while you read down the page. */
  @media (max-width: 879px) {
    .tv-btn {
      top: calc(var(--bezel-top) + 14px);
      width: 48px;
      height: 48px;
    }

    .tv-btn svg {
      width: 21px;
      height: 21px;
    }

    .tv-open svg {
      width: 20px;
      height: 20px;
    }

    .tv-home {
      left: calc(var(--bezel) + 12px);
    }

    .tv-open {
      right: calc(var(--bezel) + 12px);
    }

    html[data-reading] .tv-btn:not(:focus-visible) {
      opacity: 0;
      translate: 0 -90px;
      pointer-events: none;
    }

    html[data-reading] .tv-open:has(+ .tv-menu:popover-open:not([data-closing])) {
      opacity: 1;
      translate: 0 0;
      pointer-events: auto;
    }

    .tv-menu {
      --tile: 48px;
      top: calc(var(--bezel-top) + 14px + 48px + 12px);
      right: calc(var(--bezel) + 12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tv-open svg {
      rotate: 0deg !important;
      scale: 1 !important;
    }
  }

  @media print {
    .tv {
      display: none !important;
    }
  }
</style>
