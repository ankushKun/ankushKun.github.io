---
// Crisp UI icons for buttons and controls, unified on Hugeicons (@hugeicons/core-free-icons).
import {
  BubbleChatIcon,
  Calendar03Icon,
  Download04Icon,
  File02Icon,
  GridIcon,
  Link04Icon,
  Mail01Icon,
  Message01Icon,
  PlayIcon,
  PrinterIcon,
  RssIcon,
  ShuffleIcon,
  SourceCodeIcon,
  SparklesIcon,
  StarIcon,
  UserIcon,
} from '@hugeicons/core-free-icons';
import HugeIcon from './HugeIcon.astro';

export type UiIconName =
  | 'link'
  | 'code'
  | 'play'
  | 'mail'
  | 'phone'
  | 'doc'
  | 'post'
  | 'person'
  | 'download'
  | 'star'
  | 'rss'
  | 'grid'
  | 'chat'
  | 'print'
  | 'shuffle'
  | 'sparkle';

interface Props {
  name: UiIconName;
  size?: number;
  strokeWidth?: number;
}

const ICONS = {
  link: Link04Icon,
  code: SourceCodeIcon,
  play: PlayIcon,
  mail: Mail01Icon,
  phone: Calendar03Icon,
  doc: File02Icon,
  post: Message01Icon,
  person: UserIcon,
  download: Download04Icon,
  star: StarIcon,
  rss: RssIcon,
  grid: GridIcon,
  chat: BubbleChatIcon,
  print: PrinterIcon,
  shuffle: ShuffleIcon,
  sparkle: SparklesIcon,
} as const;

const { name, size = 20, strokeWidth = 2.1 } = Astro.props;
---

<HugeIcon icon={ICONS[name]} {size} {strokeWidth} />
