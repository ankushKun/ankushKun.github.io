---
// The small white glyphs used on buttons.
interface Props {
  name: 'link' | 'code' | 'play' | 'mail' | 'phone' | 'doc' | 'post' | 'person' | 'download' | 'star' | 'rss' | 'grid';
}

const PATHS: Record<Props['name'], string> = {
  link: 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1',
  code: 'M9 8l-4 4 4 4M15 8l4 4-4 4',
  play: 'M8 5.5v13l10.5-6.5z',
  mail: 'M4 7h16v10H4zM4.5 7.5 12 13l7.5-5.5',
  phone: 'M7 4h3l1.5 4-2 1.2a10 10 0 0 0 5.3 5.3L16 12.5l4 1.5v3a2 2 0 0 1-2 2A15 15 0 0 1 5 6a2 2 0 0 1 2-2z',
  doc: 'M7 4h7l4 4v12H7zM14 4v4h4M9.5 12h6M9.5 15.5h6',
  post: 'M5 6h14v9H10l-4 3v-3H5z',
  person: 'M12 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM5 20a7 7 0 0 1 14 0',
  download: 'M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19.5h14',
  star: 'm12 4 2.4 5 5.4.6-4 3.7 1.1 5.3L12 16l-4.9 2.6 1.1-5.3-4-3.7 5.4-.6z',
  rss: 'M6 18a1 1 0 1 0 0-.1M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14',
  grid: 'M5 5h6v6H5zM13 5h6v6h-6zM5 13h6v6H5zM13 13h6v6h-6z',
};
const { name } = Astro.props;
const filled = name === 'play' || name === 'star';
---

<svg viewBox="0 0 24 24" aria-hidden="true" fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
  <path d={PATHS[name]} />
</svg>
