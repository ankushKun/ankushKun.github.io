---
// Light or dark: a quiet icon on every screen, the plaza's included. On the TV it sits out in the
// casing's bottom left corner, past the curve of the screen; on a phone, at the top next to the
// plaza button. The moon while it is light, the sun while it is dark (src/scripts/theme.ts does
// the switching).
import { Moon02Icon, Sun03Icon } from '@hugeicons/core-free-icons';
import HugeIcon from './HugeIcon.astro';
---

<button type="button" class="theme-toggle" aria-label="Dark mode" aria-pressed="false" data-theme-toggle transition:persist="theme-toggle">
  <HugeIcon icon={Moon02Icon} size={22} strokeWidth={1.8} class="moon" />
  <HugeIcon icon={Sun03Icon} size={22} strokeWidth={1.8} class="sun" />
</button>

<style is:global>
  .theme-toggle {
    position: fixed;
    z-index: 60;
    bottom: env(safe-area-inset-bottom);
    left: env(safe-area-inset-left);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-ink-faint);
    view-transition-name: theme-toggle;
    transition:
      color 0.2s ease,
      opacity 0.25s ease,
      translate 0.35s var(--ease-glide);
  }

  .theme-toggle:hover {
    color: var(--color-ink-soft);
  }

  /* One sets as the other rises. */
  .theme-toggle svg {
    grid-area: 1 / 1;
    width: 19px;
    height: 19px;
    transition:
      opacity 0.2s ease,
      rotate 0.45s var(--ease-spring),
      translate 0.45s var(--ease-spring),
      scale 0.45s var(--ease-spring);
  }

  .theme-toggle .sun,
  :root[data-theme='dark'] .theme-toggle .moon {
    opacity: 0;
    rotate: -60deg;
    translate: 0 8px;
    scale: 0.6;
  }

  :root[data-theme='dark'] .theme-toggle .sun {
    opacity: 1;
    rotate: 0deg;
    translate: 0 0;
    scale: 1;
  }

  /* On the plaza, with no casing, it sits over the scene in the corner, a little lighter. */
  :root[data-home] .theme-toggle {
    bottom: max(12px, env(safe-area-inset-bottom));
    left: max(12px, env(safe-area-inset-left));
    color: light-dark(rgb(63 68 70 / 0.45), rgb(220 230 235 / 0.5));
  }

  :root[data-home] .theme-toggle:hover {
    color: light-dark(rgb(63 68 70 / 0.8), rgb(220 230 235 / 0.85));
  }

  /* A phone: at the top, beside the plaza button, stepping aside with it while you read. */
  @media (max-width: 879px) {
    .theme-toggle {
      top: calc(var(--bezel-top) + 18px);
      bottom: auto;
      left: calc(var(--bezel) + 66px);
      width: 40px;
      height: 40px;
    }

    .theme-toggle svg {
      width: 22px;
      height: 22px;
    }

    :root[data-home] .theme-toggle {
      top: max(12px, env(safe-area-inset-top));
      bottom: auto;
      left: max(12px, env(safe-area-inset-left));
    }

    html[data-reading] .theme-toggle:not(:focus-visible) {
      opacity: 0;
      translate: 0 -90px;
      pointer-events: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle svg {
      rotate: 0deg !important;
      translate: 0 0 !important;
      scale: 1 !important;
    }
  }

  @media print {
    .theme-toggle {
      display: none;
    }
  }
</style>
