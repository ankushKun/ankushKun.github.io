---
// A section's tile: its block's art behind a white glass rim.
import { tileFor } from '../../lib/tiles';

interface Props {
  path: string;
  size?: number;
  class?: string;
}

const { path, size = 56, class: className } = Astro.props;
const tile = tileFor(path);
---

{
  tile && (
    <span
      class:list={['tile', className]}
      style={`--s:${size}px`}
      data-tile={tile.href}
    >
      <img src={tile.src} alt="" width={size * 2} height={size * 2} decoding="async" />
    </span>
  )
}
