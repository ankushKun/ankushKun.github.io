---
// The plaza: the home page itself, by day or by night after the site's light or dark. Without
// WebGL or JavaScript it is only its haze, under the lobby's links (Lobby.astro).
import '@fontsource/m-plus-1p/latin-500.css';
import '@fontsource/m-plus-1p/latin-700.css';
import LinkBadge from '../ui/LinkBadge.astro';
import { extAttrs, NEW_TAB } from '../../lib/external';
import { resolveLink } from '../../lib/links';
import { getPlazaData } from '../../lib/plaza';
import { SOCIALS } from '../../site';

const data = await getPlazaData();
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const CORNER_SOCIALS = ['GitHub', 'X', 'YouTube', 'Instagram', 'LinkedIn', 'Discord', 'Reddit'];
const socials = CORNER_SOCIALS.flatMap((name) => {
  const s = SOCIALS.find((item) => item.platform === name);
  return s ? [{ ...s, badge: resolveLink(s.url, s.platform).badge }] : [];
});
---

<link rel="preload" href="/ffl/FFLResHigh.dat" as="fetch" crossorigin="anonymous" />
<link rel="preload" href="/ffl/ffl.wasm" as="fetch" crossorigin="anonymous" />
<link rel="preload" href="/ffl/body-m.glb" as="fetch" crossorigin="anonymous" />
<link rel="preload" href="/ffl/body-f.glb" as="fetch" crossorigin="anonymous" />
<link rel="preload" href="/media/warawara-plaza.mp3" as="fetch" crossorigin="anonymous" />
<link rel="preload" href="/fonts/monocraft-latin.otf" as="font" type="font/otf" crossorigin="anonymous" />
{data.cubes.map((c) => c.art && !c.feature && <link rel="preload" href={c.art} as="image" />)}

<section class="plaza" data-plaza data-state="static" transition:persist="plaza">
  <script is:inline>
    document.currentScript.parentElement.dataset.state = 'loading';
  </script>
  <canvas aria-hidden="true"></canvas>
  <nav class="plaza-links" aria-label="Sections">
    {
      data.cubes.map((c, i) => (
        <a href={c.href} data-cube={i} aria-label={c.label}>
          <span>{c.label}</span>
        </a>
      ))
    }
  </nav>
  <button type="button" class="plaza-dj" popovertarget="music-pop" aria-label="Music player" hidden></button>
  <div class="plaza-bubbles" aria-hidden="true"></div>
  <!-- Shared outer-only drop shadow for speech bubbles: blurs the unified body+tail silhouette and
       punches out the interior so the frosted glass above it blurs only the plaza canvas. Kept out
       of display:none so Safari resolves the filter reference. -->
  <svg class="plaza-defs" aria-hidden="true">
    <defs>
      <filter id="plaza-bubble-shadow" x="-30%" y="-40%" width="160%" height="200%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceGraphic" stdDeviation="5.5" result="blur"></feGaussianBlur>
        <feOffset in="blur" dx="0" dy="3" result="offset"></feOffset>
        <feComposite in="offset" in2="SourceAlpha" operator="out"></feComposite>
      </filter>
    </defs>
  </svg>
  <div class="plaza-who" aria-hidden="true"></div>
  <div class="plaza-corner">
    {
      socials.length > 0 && (
        <nav class="plaza-socials" aria-label="Socials">
          {socials.map((s) => (
            <a class="plaza-social" href={s.url} {...extAttrs(s.url)} aria-label={`${s.platform} ${NEW_TAB}`} data-sfx>
              <LinkBadge badge={s.badge} />
              <span class="plaza-social-tag">{s.platform}</span>
            </a>
          ))}
        </nav>
      )
    }
    <output class="plaza-fps" aria-hidden="true" hidden><span data-fps-val></span><small>FPS</small></output>
  </div>
  <button type="button" class="plaza-start" aria-label="Start">
    <svg class="plaza-start-hand" viewBox="0 0 64 64" aria-hidden="true">
      <path d="M24 30V9.5a5 5 0 0 1 10 0V27l2-.6a5 5 0 0 1 6.300 3.300l.2.700 1.900-.5a5 5 0 0 1 6.100 3.400l.3 1 1-.2a5 5 0 0 1 5.900 3.900l1.200 6.300a17 17 0 0 1-3.700 14.200L52 60H28.500L16.600 45.900a5.300 5.300 0 0 1 .7-7.600 5.300 5.300 0 0 1 6.700.2z"></path>
    </svg>
  </button>
  <div class="plaza-veil" aria-hidden="true"><span></span><span></span><span></span></div>
  <script type="application/json" data-plaza-data set:html={json} />
</section>
<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
  import { previousPath } from '../../scripts/motion';
  import type { PlazaControl } from './main';
  import type { PlazaData } from './types';

  // Starts the plaza, unless the visitor saves data: then the lobby's links are the page.
  // Once started it is kept for the rest of the visit (data-plaza-boot tells the router to carry it
  // over, src/scripts/motion.ts): going to another page puts it to sleep, coming back wakes it.
  const root = document.querySelector<HTMLElement>('[data-plaza]');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  let plaza: PlazaControl | null = null;
  if (root && saveData) root.dataset.state = 'static';
  else if (root) {
    root.setAttribute('data-plaza-boot', '');
    if (root.dataset.state === 'static') root.dataset.state = 'loading';
    const data: PlazaData = JSON.parse(root.querySelector('[data-plaza-data]')?.textContent ?? '{}');
    import('./main')
      .then(({ start }) => start(root, data))
      .then((started) => {
        plaza = started;
        // Left before it was ready (a framed plaza, /player/, is never left).
        if (location.pathname !== '/' && !document.documentElement.hasAttribute('data-embed')) started.sleep();
      })
      .catch((err: unknown) => {
        console.error('Plaza failed to start', err);
        root.dataset.state = 'static';
        root.removeAttribute('data-plaza-boot');
      });
  }
  document.addEventListener('astro:before-swap', (e) => {
    if ((e as TransitionBeforeSwapEvent).to.pathname !== '/') plaza?.sleep();
  });
  document.addEventListener('astro:after-swap', () => {
    if (location.pathname === '/') plaza?.wake(previousPath());
  });
</script>

<style is:global>
  .plaza {
    /* One unit is a hundredth of the screen's height on a 16:9 screen, as on the console. */
    --u: clamp(5.4px, min(1vh, 0.5625vw), 9px);
    --ink: light-dark(#3f4446, #dfe7ea);
    --sky: #4fbfee;
    position: relative;
    width: 100%;
    height: 100svh;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-haze);
    color: var(--ink);
    font-family: 'M PLUS 1p', ui-rounded, system-ui, sans-serif;
    font-weight: 500;
    user-select: none;
    /* Pinch and drag belong to the plaza, not the page. */
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The Music block's video plays just behind the page (film.ts): the canvas is the only cover. */
  .plaza[data-film] {
    background: transparent;
  }

  .plaza > canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .plaza button {
    padding: 0;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .plaza :focus-visible {
    outline: 3px solid var(--sky);
    outline-offset: 4px;
  }

  .plaza[data-state='static'] > *,
  .plaza[data-state='loading'] > .plaza-links,
  .plaza[data-state='loading'] > .plaza-corner {
    display: none;
  }

  /* Section links, laid over the glass blocks. When the plaza cannot run, the lobby is the menu. */

  .plaza-links {
    position: absolute;
    z-index: 1;
    inset: 0;
  }

  /* A block's name tag shows above the speech bubbles while it is pointed at. */
  .plaza-links:has(a:is(:hover, :focus-visible)) {
    z-index: 3;
  }

  .plaza-links a {
    color: inherit;
    text-decoration: none;
  }

  .plaza[data-state='live'] .plaza-links {
    pointer-events: none;
  }

  .plaza[data-state='live'] .plaza-links a {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 22%;
    pointer-events: auto;
    cursor: grab;
    -webkit-user-drag: none;
  }

  .plaza[data-state='live'] .plaza-links a:active {
    cursor: grabbing;
  }

  /* As on the Wii U, a block's name shows only when it is pointed at: a dark tag under it. */
  .plaza[data-state='live'] .plaza-links a span {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    padding: 0 calc(var(--u) * 1.8);
    border-radius: 99px;
    background: rgb(66 70 72 / 0.92);
    color: #fff;
    font-size: clamp(12px, calc(var(--u) * 1.9), 16px);
    line-height: 2;
    white-space: nowrap;
    max-width: 22em;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.18);
    opacity: 0;
    translate: -50% -4px;
    scale: 0.86;
    /* Out of the block above it. */
    transform-origin: 50% -4px;
    transition:
      opacity 0.16s ease,
      translate 0.2s cubic-bezier(0.3, 1.4, 0.5, 1),
      scale 0.22s cubic-bezier(0.3, 1.4, 0.5, 1);
    pointer-events: none;
  }

  .plaza[data-state='live'] .plaza-links a:is(:hover, :focus-visible) span {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
  }

  /* Speech bubbles, as on the console: a wide, rounded card of frosted glass with a small icon in
     its corner and the speaker's name on a dark tag over the top edge. One unit (--b) is about
     0.7% of the screen's height, held smaller on narrow screens so a bubble never covers much. */

  .plaza-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .plaza-bubbles {
    z-index: 2;
    --b: clamp(3.8px, min(0.72vh, 0.4vw), 5.4px);
    --bubble-shadow-a: 0.14;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  :root[data-theme='dark'] .plaza-bubbles {
    --bubble-shadow-a: 0.4;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .plaza-bubbles {
      --bubble-shadow-a: 0.4;
    }
  }

  .plaza-bubble {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: flex-start;
    gap: calc(var(--b) * 2.4);
    width: max-content;
    min-width: calc(var(--b) * 40);
    max-width: min(calc(var(--b) * 72), calc(100vw - 24px));
    min-height: calc(var(--b) * 15);
    padding: calc(var(--b) * 2.4) calc(var(--b) * 3.6) calc(var(--b) * 2.4) calc(var(--b) * 2.4);
    border-radius: calc(var(--b) * 3.6);
    corner-shape: squircle;
    color: light-dark(#3a3f42, #e3eaed);
    transition: color 0.5s ease;
    text-decoration: none;
    pointer-events: auto;
    /* Grows out of the head of whoever is speaking, where its tail points (bubbles.ts sets --tail,
       and --to-head, how far below the bubble the head is). */
    transform-origin: var(--tail, 30%) calc(100% + var(--to-head, 20px));
    will-change: translate, scale;
  }

  /* With wide support for squircles the radius can be larger and still read as the console's corner. */
  @supports (corner-shape: squircle) {
    .plaza-bubble {
      border-radius: calc(var(--b) * 5.2);
    }
  }

  /* The frosted glass as one unified silhouette (body + tail, clipped to --bubble-path from
     bubbles.ts) so the tail shares the exact same backdrop-filter blur pass as the body with no
     seam. The drop shadow sits behind it on a sibling SVG whose interior is punched out, so it
     wraps around the tail too without breaking backdrop-filter or darkening the glass. */
  .plaza-bubble::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% + var(--tail-h, 0px));
    background: light-dark(rgb(250 252 253 / 0.8), rgb(36 42 46 / 0.78));
    backdrop-filter: blur(calc(var(--b) * 1.2)) saturate(1.15);
    -webkit-backdrop-filter: blur(calc(var(--b) * 1.2)) saturate(1.15);
    clip-path: var(--bubble-path);
    transition: background-color 0.5s ease;
    pointer-events: none;
  }

  .plaza-bubble-shadow {
    position: absolute;
    z-index: -2;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% + var(--tail-h, 0px));
    overflow: visible;
    pointer-events: none;
  }

  .plaza-bubble-shadow path {
    fill: light-dark(#3c555f, #000);
    opacity: var(--bubble-shadow-a, 0.14);
    filter: url(#plaza-bubble-shadow);
    transition:
      fill 0.5s ease,
      opacity 0.5s ease;
  }

  /* A bubble grows out of the speaker's head and, when it goes, shrinks back into it, retracing
     the way in exactly: the same length, with each curve run backwards (bubbles.ts waits for it,
     OUT). The way out has keyframes of its own, as swapping to the same animation reversed would
     not play again: it would jump straight to its end. Each part fades on its own, since fading
     the whole would stop its glass from blurring the plaza while it did; on the way out the fade
     comes last, as it came first. */
  .plaza-bubble.is-in {
    animation: plaza-speak 0.34s var(--ease-spring) both;
  }

  .plaza-bubble.is-out {
    animation: plaza-unspeak 0.34s var(--ease-spring-back) both;
  }

  .plaza-bubble.is-in > *,
  .plaza-bubble.is-in::before {
    animation: plaza-fade 0.2s ease both;
  }

  .plaza-bubble.is-out > *,
  .plaza-bubble.is-out::before {
    animation: plaza-unfade 0.2s cubic-bezier(0.75, 0, 0.75, 0.9) 0.14s both;
  }

  @keyframes plaza-speak {
    from {
      scale: 0.04;
    }
    to {
      scale: 1;
    }
  }

  @keyframes plaza-unspeak {
    from {
      scale: 1;
    }
    to {
      scale: 0.04;
    }
  }

  @keyframes plaza-unfade {
    to {
      opacity: 0;
    }
  }

  /* Pressed: as the camera dives into whoever is saying it, the bubble grows toward you from its
     tail and goes with the rest of the plaza (main.ts, --dive). */
  .plaza-bubble.is-chosen {
    animation: plaza-bubble-dive var(--dive, 0.7s) cubic-bezier(0.4, 0, 0.6, 1) both;
  }

  @keyframes plaza-bubble-dive {
    from {
      scale: 1;
    }
    to {
      scale: 1.9;
    }
  }

  .plaza-bubble-tag {
    position: absolute;
    bottom: calc(100% - var(--b) * 1.6);
    left: calc(var(--b) * -1.2);
    padding: 0 calc(var(--b) * 1.8);
    border-radius: 99px;
    background: rgb(66 70 72 / 0.92);
    color: #fff;
    font-size: calc(var(--b) * 2.9);
    line-height: calc(var(--b) * 4.6);
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow: 0 1px calc(var(--b) * 0.8) rgb(0 0 0 / 0.18);
  }

  .plaza-bubble img {
    flex: none;
    width: calc(var(--b) * 8.4);
    height: calc(var(--b) * 8.4);
    border-radius: calc(var(--b) * 1.1);
    object-fit: cover;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  /* A chat message's sender, framed as the chat frames faces. */
  .plaza-bubble img.is-mii {
    background: linear-gradient(to bottom, light-dark(#fff, #48535a), light-dark(#eef1f3, #343d43));
  }

  /* A timeline event's date, as the calendar pages on the timeline board. */
  .plaza-bubble-cal {
    flex: none;
    display: grid;
    grid-template-rows: calc(var(--b) * 2.4) 1fr calc(var(--b) * 2.2);
    width: calc(var(--b) * 8.4);
    height: calc(var(--b) * 8.4);
    overflow: hidden;
    border-radius: calc(var(--b) * 1.1);
    background: light-dark(#fff, #2f363a);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06);
    color: light-dark(#2a2f31, #f0f4f6);
    text-align: center;
  }

  .plaza-bubble-cal span {
    background: var(--k);
    color: #fff;
    font-size: calc(var(--b) * 1.7);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: calc(var(--b) * 2.4);
    text-transform: uppercase;
  }

  .plaza-bubble-cal b {
    align-self: center;
    font-size: calc(var(--b) * 3.4);
    font-weight: 800;
    line-height: 1;
  }

  .plaza-bubble-cal small {
    font-size: calc(var(--b) * 1.6);
    font-weight: 700;
    line-height: calc(var(--b) * 1.6);
    opacity: 0.6;
  }

  .plaza-bubble-text {
    display: -webkit-box;
    overflow: hidden;
    padding-top: calc(var(--b) * 0.3);
    font-size: calc(var(--b) * 3.7);
    line-height: 1.3;
    letter-spacing: 0.005em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* A drawing in place of the text, as Miiverse showed them on the plaza. */
  .plaza-bubble.has-drawing {
    padding-right: calc(var(--b) * 2.4);
  }

  /* A Paint day, on its white paper. */
  .plaza-bubble img.plaza-bubble-drawing {
    width: calc(var(--b) * 44);
    height: auto;
    aspect-ratio: 16 / 10;
    background: #fff;
  }

  /* A chat drawing is black ink with no paper of its own: on the glass by day, and at night turned
     white, the black left behind blended away, as the chat shows them. */
  .plaza-bubble img.plaza-bubble-drawing.is-ink {
    width: calc(var(--b) * 56);
    aspect-ratio: 320 / 120;
    border-radius: 0;
    background: none;
    box-shadow: none;
    image-rendering: pixelated;
    mix-blend-mode: multiply;
  }

  :root[data-theme='dark'] .plaza-bubble img.plaza-bubble-drawing.is-ink {
    filter: invert(1);
    mix-blend-mode: screen;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .plaza-bubble img.plaza-bubble-drawing.is-ink {
      filter: invert(1);
      mix-blend-mode: screen;
    }
  }

  /* Miis can be picked up. */
  .plaza[data-over='true'] {
    cursor: grab;
  }

  .plaza[data-holding],
  .plaza[data-panning],
  .plaza[data-panning] * {
    cursor: grabbing;
  }

  /* The DJ under the Music block opens the music player over their head (main.ts keeps the
     button on them). */
  .plaza-dj {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 40%;
    background: none;
    visibility: hidden;
  }

  .plaza[data-state='live'] .plaza-dj.is-on {
    visibility: visible;
  }

  /* Name tags are set in Monocraft (Idrees Hassan, SIL Open Font License, public/fonts/), a pixel
     font after Minecraft's, cut down to Latin letters. */
  @font-face {
    font-family: 'Monocraft';
    src: url('/fonts/monocraft-latin.otf') format('opentype');
    font-display: block;
  }

  /* Bottom-left corner: social icon links matching the top-left dock, with the frame rate right beside them. */
  .plaza-corner {
    position: absolute;
    z-index: 9;
    bottom: max(12px, env(safe-area-inset-bottom));
    left: max(12px, env(safe-area-inset-left));
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: none;
  }

  .plaza-socials {
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .plaza-social {
    position: relative;
    display: grid;
    place-items: center;
    padding: 3px;
    border-radius: 9px;
    text-decoration: none;
    pointer-events: auto;
  }

  .plaza-social .link-badge {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    opacity: 0.92;
    box-shadow:
      0 0 0 1px light-dark(rgb(55 70 78 / 0.13), rgb(255 255 255 / 0.16)),
      0 2px 6px -2px light-dark(rgb(25 50 65 / 0.24), rgb(0 0 0 / 0.55));
    transition:
      opacity 0.18s ease,
      scale 0.3s var(--ease-spring),
      translate 0.3s var(--ease-spring),
      box-shadow 0.18s ease;
  }

  .plaza-social .link-badge::after {
    border-radius: 7px 7px 40% 40% / 7px 7px 20% 20%;
  }

  .plaza-social .link-badge:not(.is-bleed) svg {
    width: 14px;
    height: 14px;
  }

  .plaza-social:focus-visible {
    box-shadow: none;
  }

  .plaza-social:focus-visible .link-badge {
    opacity: 1;
    scale: 1.14;
    translate: 0 -1px;
    box-shadow: var(--glow);
  }

  @media (hover: hover) {
    .plaza-social:hover .link-badge {
      opacity: 1;
      scale: 1.15;
      translate: 0 -1px;
      box-shadow:
        0 0 0 1px light-dark(rgb(55 70 78 / 0.18), rgb(255 255 255 / 0.24)),
        0 4px 10px -2px light-dark(rgb(25 50 65 / 0.32), rgb(0 0 0 / 0.65));
    }
  }

  .plaza-social:active .link-badge {
    scale: 0.94;
    translate: 0 0;
    transition-duration: 0.08s;
  }

  .plaza-social-tag {
    position: absolute;
    bottom: calc(100% + 5px);
    left: 50%;
    padding: 0 10px;
    border-radius: 99px;
    background: rgb(66 70 72 / 0.92);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 24px;
    white-space: nowrap;
    box-shadow:
      0 0 0 1px light-dark(transparent, rgb(255 255 255 / 0.08)),
      0 2px 8px rgb(0 0 0 / 0.24);
    opacity: 0;
    translate: -50% 4px;
    scale: 0.86;
    transform-origin: 50% calc(100% + 4px);
    pointer-events: none;
    transition:
      opacity 0.16s ease,
      translate 0.2s cubic-bezier(0.3, 1.4, 0.5, 1),
      scale 0.22s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .plaza-social:nth-child(-n + 2) .plaza-social-tag {
    left: 0;
    translate: 0 4px;
    transform-origin: 12px calc(100% + 4px);
  }

  .plaza-social:focus-visible .plaza-social-tag {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
  }

  .plaza-social:nth-child(-n + 2):focus-visible .plaza-social-tag {
    translate: 0 0;
  }

  @media (hover: hover) {
