---
// The plaza: the home page itself, by day or by night after the site's light or dark. Without
// WebGL or JavaScript it shows a plain grid of links.
// `lazy` leaves its data and the early downloads out: other pages fetch /plaza.json if and when
// the plaza starts behind them.
import '@fontsource/m-plus-1p/latin-500.css';
import '@fontsource/m-plus-1p/latin-700.css';
import { getPlazaData } from '../../lib/plaza';

interface Props {
  lazy?: boolean;
}

const { lazy = false } = Astro.props;
const data = lazy ? null : await getPlazaData();
const json = data ? JSON.stringify(data).replace(/</g, '\\u003c') : '';
---

{
  data && (
    <>
      <link rel="preload" href="/ffl/FFLResHigh.dat" as="fetch" crossorigin="anonymous" />
      <link rel="preload" href="/ffl/ffl.wasm" as="fetch" crossorigin="anonymous" />
      <link rel="preload" href="/ffl/body-m.glb" as="fetch" crossorigin="anonymous" />
      <link rel="preload" href="/ffl/body-f.glb" as="fetch" crossorigin="anonymous" />
      <link rel="preload" href="/media/warawara-plaza.mp3" as="fetch" crossorigin="anonymous" />
      {data.cubes.map((c) => c.art && !c.feature && <link rel="preload" href={c.art} as="image" />)}
    </>
  )
}

<section class="plaza" data-plaza data-state="static">
  <script is:inline>
    document.currentScript.parentElement.dataset.state = 'loading';
  </script>
  <canvas aria-hidden="true"></canvas>
  <nav class="plaza-links" aria-label="Sections">
    {
      data?.cubes.map((c, i) => (
        <a href={c.href} data-cube={i} aria-label={c.label}>
          <span>{c.label}</span>
        </a>
      ))
    }
  </nav>
  <div class="plaza-bubbles" aria-hidden="true"></div>
  <div class="plaza-who" aria-hidden="true"><img alt="" width="188" height="188" /><span></span></div>
  <div class="plaza-ghost tile" aria-hidden="true"><img alt="" /></div>
  <button type="button" class="plaza-start" aria-label="Start">
    <svg class="plaza-start-hand" viewBox="0 0 64 64" aria-hidden="true">
      <path d="M24 30V9.5a5 5 0 0 1 10 0V27l2-.6a5 5 0 0 1 6.300 3.300l.2.700 1.900-.5a5 5 0 0 1 6.100 3.400l.3 1 1-.2a5 5 0 0 1 5.900 3.900l1.200 6.300a17 17 0 0 1-3.700 14.200L52 60H28.500L16.600 45.900a5.300 5.300 0 0 1 .7-7.600 5.300 5.300 0 0 1 6.700.2z"></path>
    </svg>
  </button>
  <div class="plaza-veil" aria-hidden="true"><span></span><span></span><span></span></div>
  {data && <script type="application/json" data-plaza-data set:html={json} />}
</section>

<script>
  import type { PlazaData } from './types';

  // The plaza starts once and then lives on across page changes (see src/scripts/motion.ts). On the
  // home page it starts at once. Behind another page it starts only where there is room for it (a
  // big screen, a fine pointer, memory to spare), once the page itself has loaded, and fades in.
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const roomy = () => {
    const device = navigator as Navigator & { deviceMemory?: number };
    return matchMedia('(pointer: fine) and (min-width: 1000px) and (min-height: 620px)').matches && (device.deviceMemory ?? 8) >= 4;
  };

  function boot() {
    const root = document.querySelector<HTMLElement>('[data-plaza]');
    if (!root || root.dataset.boot) return;
    const home = location.pathname === '/';
    if (saveData) {
      root.dataset.state = 'static';
      return;
    }
    if (!home && !roomy()) return;
    root.dataset.boot = '1';
    const inline = root.querySelector('[data-plaza-data]')?.textContent;
    const data: Promise<PlazaData> = inline ? Promise.resolve(JSON.parse(inline)) : fetch('/plaza.json').then((r) => r.json());
    const later = home ? Promise.resolve() : new Promise((done) => setTimeout(done, 400));
    Promise.all([import('./main'), data, later])
      .then(([{ start }, plaza]) => start(root, plaza, { backdrop: location.pathname === '/' ? undefined : location.pathname }))
      .catch((err: unknown) => {
        console.error('Plaza failed to start', err);
        root.dataset.state = 'static';
        delete root.dataset.boot;
      });
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

<style is:global>
  .plaza {
    /* One unit is a hundredth of the screen's height on a 16:9 screen, as on the console. */
    --u: clamp(5.4px, min(1vh, 0.5625vw), 9px);
    --ink: light-dark(#3f4446, #dfe7ea);
    --sky: #4fbfee;
    position: relative;
    width: 100%;
    height: 100svh;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-haze);
    color: var(--ink);
    font-family: 'M PLUS 1p', ui-rounded, system-ui, sans-serif;
    font-weight: 500;
    user-select: none;
    /* Pinch and drag belong to the plaza, not the page. */
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  .plaza > canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .plaza button {
    padding: 0;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .plaza :focus-visible {
    outline: 3px solid var(--sky);
    outline-offset: 4px;
  }

  .plaza[data-state='static'] > :not(.plaza-links),
  .plaza[data-state='loading'] > .plaza-links {
    display: none;
  }

  /* Section links: laid over the glass blocks when the plaza runs, a plain grid when it cannot. */

  .plaza-links {
    position: absolute;
    z-index: 1;
    inset: 0;
  }

  /* A block's name tag shows above the speech bubbles while it is pointed at. */
  .plaza-links:has(a:is(:hover, :focus-visible)) {
    z-index: 3;
  }

  .plaza-links a {
    color: inherit;
    text-decoration: none;
  }

  .plaza[data-state='live'] .plaza-links {
    pointer-events: none;
  }

  .plaza[data-state='live'] .plaza-links a {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 22%;
    pointer-events: auto;
    cursor: grab;
    -webkit-user-drag: none;
  }

  .plaza[data-state='live'] .plaza-links a:active {
    cursor: grabbing;
  }

  /* As on the Wii U, a block's name shows only when it is pointed at: a dark tag under it. */
  .plaza[data-state='live'] .plaza-links a span {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    padding: 0 calc(var(--u) * 1.8);
    border-radius: 99px;
    background: rgb(66 70 72 / 0.92);
    color: #fff;
    font-size: clamp(12px, calc(var(--u) * 1.9), 16px);
    line-height: 2;
    white-space: nowrap;
    max-width: 22em;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 1px 6px rgb(0 0 0 / 0.18);
    opacity: 0;
    translate: -50% -4px;
    scale: 0.86;
    /* Out of the block above it. */
    transform-origin: 50% -4px;
    transition:
      opacity 0.16s ease,
      translate 0.2s cubic-bezier(0.3, 1.4, 0.5, 1),
      scale 0.22s cubic-bezier(0.3, 1.4, 0.5, 1);
    pointer-events: none;
  }

  .plaza[data-state='live'] .plaza-links a:is(:hover, :focus-visible) span {
    opacity: 1;
    translate: -50% 0;
    scale: 1;
  }

  .plaza[data-state='static'] .plaza-links {
    display: flex;
    flex-wrap: wrap;
    place-content: center;
    gap: 12px;
    max-width: 40rem;
    margin: auto;
    padding: 24px;
  }

  .plaza[data-state='static'] .plaza-links a {
    padding: 12px 22px;
    border-radius: 18px;
    background: light-dark(#fff, #262c30);
    box-shadow: 0 2px 10px light-dark(rgb(60 90 95 / 0.14), rgb(0 0 0 / 0.5));
    font-weight: 700;
  }

  /* Speech bubbles, as on the console: a wide, rounded card of frosted glass with a small icon in
     its corner and the speaker's name on a dark tag over the top edge. One unit (--b) is about
     0.7% of the screen's height, held smaller on narrow screens so a bubble never covers much. */

  .plaza-bubbles {
    z-index: 2;
    --b: clamp(3.8px, min(0.72vh, 0.4vw), 5.4px);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .plaza-bubble {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: flex-start;
    gap: calc(var(--b) * 2.4);
    width: max-content;
    min-width: calc(var(--b) * 40);
    max-width: min(calc(var(--b) * 72), calc(100vw - 24px));
    min-height: calc(var(--b) * 15);
    padding: calc(var(--b) * 2.4) calc(var(--b) * 3.6) calc(var(--b) * 2.4) calc(var(--b) * 2.4);
    border-radius: calc(var(--b) * 3.6);
    corner-shape: squircle;
    background: light-dark(rgb(250 252 253 / 0.8), rgb(36 42 46 / 0.78));
    backdrop-filter: blur(calc(var(--b) * 1.2)) saturate(1.15);
    -webkit-backdrop-filter: blur(calc(var(--b) * 1.2)) saturate(1.15);
    box-shadow:
      inset 0 0 0 1px light-dark(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.1)),
      0 0 0 1px light-dark(rgb(80 100 110 / 0.14), rgb(0 0 0 / 0.5)),
      0 calc(var(--b) * 0.6) calc(var(--b) * 2.4) light-dark(rgb(60 85 95 / 0.12), rgb(0 0 0 / 0.4));
    color: light-dark(#3a3f42, #e3eaed);
    transition:
      background-color 0.5s ease,
      color 0.5s ease;
    text-decoration: none;
    opacity: 0;
    pointer-events: auto;
    /* Grows out of its tail, which points at whoever is speaking (bubbles.ts sets --tail). */
    transform-origin: var(--tail, 30%) calc(100% + 14px);
    will-change: transform;
  }

  /* With wide support for squircles the radius can be larger and still read as the console's corner. */
  @supports (corner-shape: squircle) {
    .plaza-bubble {
      border-radius: calc(var(--b) * 5.2);
    }
  }

  .plaza-bubble.is-in {
    animation: plaza-pop 0.3s cubic-bezier(0.3, 1.5, 0.5, 1) both;
  }

  .plaza-bubble.is-out {
    animation: plaza-pop 0.26s ease-in reverse both;
  }

  .plaza-bubble-tag {
    position: absolute;
    bottom: calc(100% - var(--b) * 1.6);
    left: calc(var(--b) * -1.2);
    padding: 0 calc(var(--b) * 1.8);
    border-radius: 99px;
    background: rgb(66 70 72 / 0.92);
    color: #fff;
    font-size: calc(var(--b) * 2.9);
    line-height: calc(var(--b) * 4.6);
    letter-spacing: 0.01em;
    white-space: nowrap;
    box-shadow: 0 1px calc(var(--b) * 0.8) rgb(0 0 0 / 0.18);
  }

  .plaza-bubble img {
    flex: none;
    width: calc(var(--b) * 8.4);
    height: calc(var(--b) * 8.4);
    border-radius: calc(var(--b) * 1.1);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.06);
  }

  .plaza-bubble-text {
    display: -webkit-box;
    overflow: hidden;
    padding-top: calc(var(--b) * 0.3);
    font-size: calc(var(--b) * 3.7);
    line-height: 1.3;
    letter-spacing: 0.005em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* Miis can be picked up. */
  .plaza[data-over='true'] {
    cursor: grab;
  }

  .plaza[data-holding] {
    cursor: grabbing;
  }

  /* Who a Mii is, over its head once the pointer rests on it: its name and its QR code. */
  .plaza-who {
    --b: clamp(3.8px, min(0.72vh, 0.4vw), 5.4px);
    position: absolute;
    z-index: 4;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--b) * 1.6);
    padding: calc(var(--b) * 2.2);
    border-radius: calc(var(--b) * 3.6);
    corner-shape: squircle;
    background: light-dark(rgb(250 252 253 / 0.86), rgb(36 42 46 / 0.84));
    backdrop-filter: blur(calc(var(--b) * 1.2)) saturate(1.15);
    -webkit-backdrop-filter: blur(calc(var(--b) * 1.2)) saturate(1.15);
    box-shadow:
      inset 0 0 0 1px light-dark(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.1)),
      0 0 0 1px light-dark(rgb(80 100 110 / 0.14), rgb(0 0 0 / 0.5)),
      0 calc(var(--b) * 0.6) calc(var(--b) * 2.4) light-dark(rgb(60 85 95 / 0.12), rgb(0 0 0 / 0.4));
    opacity: 0;
    scale: 0.85;
    /* Grows out of the head it names, wherever the card had to sit to stay on screen (main.ts). */
    transform-origin: var(--ox, 50%) var(--oy, 100%);
    transition:
      opacity 0.16s ease,
      scale 0.22s cubic-bezier(0.3, 1.5, 0.5, 1);
    pointer-events: none;
  }

  .plaza-who.is-in {
    opacity: 1;
    scale: 1;
  }

  .plaza-who img {
    display: block;
    width: calc(var(--b) * 24);
    height: calc(var(--b) * 24);
    border-radius: calc(var(--b) * 1.2);
    image-rendering: pixelated;
  }

  .plaza-who img[hidden] {
    display: none;
  }

  .plaza-who span {
    padding: 0 calc(var(--b) * 1.8);
    border-radius: 99px;
    background: rgb(66 70 72 / 0.92);
    color: #fff;
    font-size: calc(var(--b) * 2.9);
    line-height: calc(var(--b) * 4.6);
    white-space: nowrap;
  }

  /* The prompt over your floating Mii: a tapping hand. */

  .plaza-start {
    --size: 120px;
    position: absolute;
    top: 0;
    left: 0;
    display: none;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .plaza[data-state='live'][data-waiting] .plaza-start {
    display: block;
  }

  .plaza[data-state='live'][data-waiting='true'] .plaza-start {
    opacity: 1;
  }

  .plaza[data-waiting='false'] .plaza-start {
    pointer-events: none;
    transition-duration: 0.15s;
  }

  .plaza-start:focus-visible {
    outline-offset: 0;
  }

  .plaza-start-hand {
    position: absolute;
    top: 62%;
    left: 60%;
    width: 30%;
    height: 30%;
    overflow: visible;
    filter: drop-shadow(0 calc(var(--size) * 0.02) calc(var(--size) * 0.03) rgb(40 70 80 / 0.35));
    transform-origin: 35% 15%;
    animation: plaza-tap 1.8s ease-in-out infinite;
  }

  .plaza-start-hand path {
    fill: #fff;
    stroke: #9aa7aa;
    stroke-width: 2.2;
    stroke-linejoin: round;
  }

  @keyframes plaza-tap {
    0%,
    100% {
      translate: 6% 10%;
      rotate: 0deg;
    }
    8% {
      translate: -4% -6%;
      rotate: -6deg;
      scale: 0.92;
    }
    16%,
    60% {
      translate: 6% 10%;
      rotate: 0deg;
      scale: 1;
    }
  }

  /* Diving into a block: a flat copy of its art grows over it, and flies on into the next page. */
  .plaza-ghost {
    position: absolute;
    z-index: 3;
    top: 0;
    left: 0;
    display: none !important;
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .plaza-ghost[data-on] {
    display: block !important;
  }

  /* White out while loading. Three orbs wait with you if it is slow. */

  .plaza-veil {
    position: absolute;
    inset: 0;
    display: flex;
    place-content: center;
    place-items: center;
    gap: calc(var(--u) * 2.4);
    background: light-dark(#e9f3f4, #13171a);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .plaza[data-state='loading'] .plaza-veil {
    opacity: 1;
    transition: none;
  }

  .plaza-veil span {
    width: calc(var(--u) * 2.6);
    height: calc(var(--u) * 2.6);
    border-radius: 50%;
    background: light-dark(#b9c8c8, #3c474c);
    opacity: 0;
  }

  .plaza[data-state='loading'] .plaza-veil span {
    animation: plaza-wait 1.2s ease-in-out 0.9s infinite both;
  }

  .plaza[data-state='loading'] .plaza-veil span:nth-child(2) {
    animation-delay: 1.05s;
  }

  .plaza[data-state='loading'] .plaza-veil span:nth-child(3) {
    animation-delay: 1.2s;
  }

  @keyframes plaza-pop {
    from {
      opacity: 0;
      scale: 0.82;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes plaza-wait {
    0%,
    100% {
      opacity: 0.25;
      scale: 0.8;
    }
    50% {
      opacity: 1;
      scale: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plaza-start-hand {
      animation: none;
    }

    .plaza-bubble.is-in,
    .plaza-bubble.is-out {
      animation-timing-function: linear;
      scale: 1 !important;
    }
  }
</style>
