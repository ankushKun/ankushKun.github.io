---
// The timeline as the Wii's message board: each event a memo under its year, dated by a little
// calendar page whose top is the color of its kind (a win, a launch, work...).
import type { CollectionEntry } from 'astro:content';
import { byYear, isoDate, urlOf } from '../lib/content';

interface Props {
  items: CollectionEntry<'timeline'>[];
}

const KINDS: Record<string, string> = {
  win: '#f2a312',
  launch: '#ee4a4f',
  work: '#2380dc',
  hackathon: '#7a4fe0',
  hardware: '#1f9457',
  milestone: '#24b3cc',
};
const kindColor = (k: string) => KINDS[k] ?? '#8a9497';
const month = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
---

<div class="board">
  {
    byYear(Astro.props.items).map(([year, events]) => (
      <section>
        <h2 class="year">{year}</h2>
        <ol>
          {events.map((e) => (
            <li>
              <a href={urlOf(e)} class="memo" data-sfx>
                <time class="cal" datetime={isoDate(e.data.date)} style={`--k:${kindColor(e.data.kind)}`} title={e.data.kind}>
                  <span>{month(e.data.date)}</span>
                  <b>{e.data.date.getUTCDate()}</b>
                </time>
                <span class="text">
                  <span class="title">{e.data.title}</span>
                  <span class="desc">{e.data.description}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .year {
    margin: 30px 0 6px;
    color: var(--color-ink-faint);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  section:first-child .year {
    margin-top: 0;
  }

  .memo {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin: 0 -14px;
    padding: 12px 14px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow 0.18s ease,
      background 0.18s ease;
  }

  .memo:hover,
  .memo:focus-visible {
    background: var(--color-raise);
    box-shadow: var(--glow);
  }

  /* A page off a desk calendar: the month on a band of the kind's color, the day under it. */
  .cal {
    flex: none;
    width: 52px;
    overflow: hidden;
    border-radius: 10px;
    background: light-dark(#fff, #2f363a);
    box-shadow:
      var(--rim),
      0 2px 4px light-dark(rgb(30 50 60 / 0.12), rgb(0 0 0 / 0.4));
    text-align: center;
  }

  .cal span {
    display: block;
    background: var(--k);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 18px;
    text-transform: uppercase;
  }

  .cal b {
    display: block;
    color: var(--color-ink-strong);
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 34px;
  }

  .text {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding-top: 2px;
  }

  .title {
    color: var(--color-ink-strong);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .desc {
    display: -webkit-box;
    overflow: hidden;
    color: var(--color-ink-soft);
    font-size: 0.875rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 479px) {
    .memo {
      gap: 14px;
      margin: 0 -10px;
      padding: 10px;
    }
  }
</style>
