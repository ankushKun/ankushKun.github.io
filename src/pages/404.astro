---
import Base from '../layouts/Base.astro';
import BackButton from '../components/ui/BackButton.astro';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <div class="lost" data-not-found>
    <div class="say">
      <span class="tag">404</span>
      <h1>This page wandered off</h1>
    </div>
    <img src="/mii/me-lost.webp" alt="" width="360" height="470" class="mii" />
    <BackButton href="/" label="Plaza" />
  </div>
</Base>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding-top: 6vh;
    text-align: center;
  }

  /* A speech bubble over the lost Mii's head. */
  .say {
    position: relative;
    padding: 20px 30px;
    border-radius: 24px;
    background: var(--color-raise);
    box-shadow:
      var(--rim),
      0 10px 24px -12px light-dark(rgb(30 50 60 / 0.4), rgb(0 0 0 / 0.6));
    /* Out of its tail, above the lost Mii. */
    transform-origin: 50% calc(100% + 9px);
    animation: say 0.5s var(--ease-spring) 0.15s both;
  }

  .say::after {
    content: '';
    position: absolute;
    bottom: -9px;
    left: 50%;
    width: 18px;
    height: 18px;
    border-radius: 0 0 4px;
    background: inherit;
    box-shadow: 1px 1px 0 light-dark(rgb(55 70 78 / 0.2), rgb(0 0 0 / 0.6));
    translate: -50% 0;
    rotate: 45deg;
  }

  .tag {
    position: absolute;
    top: -11px;
    left: 20px;
    padding: 0 0.85em;
    border-radius: 99px;
    background: var(--color-tag);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.85;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .mii {
    width: min(200px, 26vh, 50vw);
    height: auto;
    margin: 4px 0 10px;
    filter: drop-shadow(0 18px 10px rgb(30 50 60 / 0.18));
    animation: wobble 3.2s ease-in-out infinite;
    transform-origin: 50% 100%;
  }

  @keyframes say {
    from {
      opacity: 0;
      scale: 0.82;
    }
  }

  @keyframes wobble {
    25% {
      rotate: -3deg;
    }
    75% {
      rotate: 3deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mii,
    .say {
      animation: none;
    }
  }
</style>
