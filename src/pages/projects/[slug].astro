---
import Entry from '../../layouts/Entry.astro';
import MenuButton from '../../components/ui/MenuButton.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEntries('projects')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<Entry entry={entry}>
  <div slot="meta" class="meta">
    {
      (data.status === 'archived' || data.stack.length > 0) && (
        <ul class="stack">
          {data.status === 'archived' && <li class="pill">Archived</li>}
          {data.stack.map((s) => (
            <li class="chip">{s}</li>
          ))}
        </ul>
      )
    }
    {
      data.links.length > 0 && (
        <div class="links">
          {data.links.map((l) => (
            <MenuButton href={l.url} label={l.label} />
          ))}
        </div>
      )
    }
  </div>
</Entry>

<style>
  .meta {
    display: grid;
    gap: 18px;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
    gap: 10px;
  }
</style>
