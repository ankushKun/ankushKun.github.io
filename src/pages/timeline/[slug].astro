---
import Entry from '../../layouts/Entry.astro';
import MenuButton from '../../components/ui/MenuButton.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEntries('timeline')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<Entry entry={entry}>
  <div slot="meta" class="meta">
    <span class="pill">{data.kind.charAt(0).toUpperCase() + data.kind.slice(1)}</span>
    {
      data.links.length > 0 && (
        <div class="links">
          {data.links.map((l) => (
            <MenuButton href={l.url} label={l.label} />
          ))}
        </div>
      )
    }
  </div>
</Entry>

<style>
  .meta {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
    width: 100%;
  }
</style>
