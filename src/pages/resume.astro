---
import Page from '../layouts/Page.astro';
import MenuButton from '../components/ui/MenuButton.astro';
import { resume } from '../data/resume';
import { formatMonth } from '../lib/content';
import { inline } from '../lib/inline';
import { NEW_TAB, extAttrs, isExternal } from '../lib/external';
---

<Page id="resume">
  <div class="top">
    <p class="summary" set:html={inline(resume.summary)} />
    <div class="resume-actions">
      <MenuButton href={resume.pdf} download={resume.pdfDownloadName} label="Download PDF" tile="/resume/" />
      <MenuButton id="resume-print" label="Print page" icon="print" />
    </div>
  </div>

  <section>
    <h2>Experience</h2>
    {
      resume.experience.map((e) => (
        <div class="item">
          <p class="when">
            {formatMonth(e.start)} to {formatMonth(e.end)}
          </p>
          <div>
            <h3>
              {e.role},{' '}
              <a href={e.url} class:list={[{ ext: isExternal(e.url) }]} {...extAttrs(e.url)}>
                {e.org}
                {isExternal(e.url) && <span class="sr-only">{NEW_TAB}</span>}
              </a>
            </h3>
            {e.location && <p class="where">{e.location}</p>}
            <ul>
              {e.highlights.map((h) => (
                <li set:html={inline(h)} />
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </section>

  {
    resume.projects.length > 0 && (
      <section>
        <h2>Selected projects</h2>
        {resume.projects.map((p) => (
          <div class="item">
            <p class="when">{formatMonth(p.start)}</p>
            <div>
              <h3>
                <a href={p.more ?? p.url} class:list={[{ ext: isExternal(p.more ?? p.url) }]} {...extAttrs(p.more ?? p.url)}>
                  {p.name}
                  {isExternal(p.more ?? p.url) && <span class="sr-only">{NEW_TAB}</span>}
                </a>
              </h3>
              <p class="where">{p.tech.join(', ')}</p>
              <ul>
                {p.highlights.map((h) => (
                  <li set:html={inline(h)} />
                ))}
              </ul>
            </div>
          </div>
        ))}
      </section>
    )
  }

  <section>
    <h2>Education</h2>
    {
      resume.education.map((e) => (
        <div class="item">
          <p class="when">{e.start ? <>{formatMonth(e.start)} to {formatMonth(e.end)}</> : ''}</p>
          <div>
            <h3>
              {e.degree} in {e.field}
            </h3>
            <p class="where">{e.school}</p>
          </div>
        </div>
      ))
    }
  </section>

  <section>
    <h2>Skills</h2>
    {
      resume.skills.map((s) => (
        <div class="item">
          <p class="when">{s.label}</p>
          <ul class="skills">
            {s.items.map((x) => (
              <li class="chip">{x}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Page>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('resume-print');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = '1';
    btn.addEventListener('click', () => window.print());
  });
</script>

<style>
  .top {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .resume-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 560px;
  }

  .summary {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .summary :global(strong) {
    color: var(--color-ink-strong);
  }

  section {
    margin-top: 2.75rem;
  }

  h2 {
    margin-bottom: 1.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 1.125rem;
    font-weight: 800;
  }

  .item {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 4px 20px;
  }

  .item + .item {
    margin-top: 1.4rem;
  }

  .when {
    padding-top: 2px;
    color: var(--color-ink-soft);
    font-size: 0.875rem;
  }

  h3 {
    font-weight: 700;
    line-height: 1.4;
  }

  h3 a,
  .summary :global(a),
  li :global(a) {
    text-decoration: underline;
    text-decoration-color: rgb(47 178 230 / 0.5);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .where {
    color: var(--color-ink-soft);
    font-size: 0.875rem;
  }

  ul:not(.skills) {
    margin-top: 0.4rem;
    padding-left: 1.1rem;
    list-style: disc;
    line-height: 1.7;
  }

  ul:not(.skills) li::marker {
    color: var(--color-sky);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 600px) {
    .item {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media print {
    .top :global(.menu-btn) {
      display: none;
    }
  }
</style>
