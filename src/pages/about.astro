---
// About: who you are, set as type rather than boxes. Your Mii on its stage, saying hello (tap it to
// wave), beside your name, what you build and the way to reach you; the story (content/pages/
// about.md); your work as plain rows, years, company, role and what came of it (data/resume.ts);
// and your socials (site.ts). Each company's logo is src/assets/work/<company>.png, named as its
// name in lower case with dashes: a transparent square, no background of its own. A logo drawn in
// black alone is named <company>.mono.png instead, and turns white in the dark.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { File02Icon, Mail01Icon } from '@hugeicons/core-free-icons';
import Page from '../layouts/Page.astro';
import HugeIcon from '../components/ui/HugeIcon.astro';
import LinkBadge from '../components/ui/LinkBadge.astro';
import MiiStage from '../components/mii/Stage.astro';
import { AUTHOR, SOCIALS, SUPPORT } from '../site';
import { NEW_TAB, extAttrs } from '../lib/external';
import { resolveLink } from '../lib/links';
import { resume } from '../data/resume';
import { HEADLINE, QUIPS } from '../data/profile';
import { getPage } from '../lib/content';

const { Content } = await render(await getPage('about'));

const year = (ym?: string) => (ym ? ym.slice(0, 4) : 'Now');
const years = (start: string, end?: string) => (year(start) === year(end) ? year(start) : `${year(start)} to ${year(end)}`);
const LOGOS = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.png', { eager: true });
const logoOf = (org: string) => {
  const name = `../assets/work/${org.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
  const mono = LOGOS[`${name}.mono.png`]?.default;
  return { logo: mono ?? LOGOS[`${name}.png`]?.default, mono: Boolean(mono) };
};
const work = resume.experience.map((e) => ({ ...e, ...logoOf(e.org), badge: resolveLink(e.url, e.org).badge }));
const socials = SOCIALS.map((s) => ({ ...s, badge: resolveLink(s.url, s.platform).badge }));
const support = SUPPORT.map((s) => ({ ...s, badge: resolveLink(s.url, s.platform).badge }));
---

<Page id="about" pageType="ProfilePage" type="profile" layout="bare" centered>
  <div class="about">
    <section class="intro" aria-label="Profile">
      <div class="mii" data-stage-wrap>
        <p class="bubble" data-stage-quip aria-live="polite">{QUIPS[0]}</p>
        <MiiStage />
      </div>
      <div class="who">
        <h2 class="name">{AUTHOR.name}</h2>
        <p class="role">
          {AUTHOR.jobTitle} at{' '}
          <a href={AUTHOR.worksFor.url} {...extAttrs(AUTHOR.worksFor.url)}>
            {AUTHOR.worksFor.name}
            <span class="sr-only">{NEW_TAB}</span>
          </a>
        </p>
        <p class="headline">{HEADLINE}</p>
      </div>
      <div class="ctas">
        <a href="/contact/" class="cta cta-go" data-sfx>
          <HugeIcon icon={Mail01Icon} size={19} strokeWidth={2} />
          Say hello
        </a>
        <a href="/resume/" class="cta" data-sfx>
          <HugeIcon icon={File02Icon} size={19} strokeWidth={2} />
          Resume
        </a>
      </div>
    </section>

    <div class="prose story">
      <Content />
    </div>

    <section aria-labelledby="work">
      <h2 class="section-head" id="work">Work</h2>
      <ol class="work">
        {
          work.map((w) => (
            <li>
              <span class="years">{years(w.start, w.end)}</span>
              {w.logo ? <Image class:list={['logo', w.mono && 'mono']} src={w.logo} alt="" width={40} height={40} densities={[1, 2, 3]} /> : <LinkBadge badge={w.badge} />}
              <div class="job">
                <p class="title">
                  <span class="job-role">{w.role}</span>
                  <span class="at">at</span>
                  <a href={w.url} {...extAttrs(w.url)}>
                    {w.org}
                    <span class="sr-only">{NEW_TAB}</span>
                  </a>
                </p>
                {w.summary && <p class="summary">{w.summary}</p>}
              </div>
            </li>
          ))
        }
      </ol>
      <a href="/resume/" class="more" data-sfx>The full resume, with projects and skills</a>
    </section>

    <section aria-labelledby="socials">
      <h2 class="section-head" id="socials">Socials</h2>
      <ul class="socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank">
                <LinkBadge badge={s.badge} />
                <span>{s.platform}</span>
                <span class="sr-only">{NEW_TAB}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="support">
      <h2 class="section-head" id="support">Support</h2>
      <ul class="socials">
        {
          support.map((s) => (
            <li>
              <a href={s.url} rel="noopener" target="_blank">
                <LinkBadge badge={s.badge} />
                <span>{s.platform}</span>
                <span class="sr-only">{NEW_TAB}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Page>

<script>
  import { QUIPS } from '../data/profile';

  // Tapping your Mii waves (stage.ts) and has it say the next thing.
  function wireQuips() {
    const wrap = document.querySelector<HTMLElement>('[data-stage-wrap]');
    const quip = wrap?.querySelector<HTMLElement>('[data-stage-quip]');
    if (!wrap || !quip || wrap.dataset.wired) return;
    wrap.dataset.wired = '1';
    let i = 1;
    wrap.querySelector('canvas')?.addEventListener('click', () => {
      quip.textContent = QUIPS[i++ % QUIPS.length];
      quip.classList.remove('is-new');
      void quip.offsetWidth;
      quip.classList.add('is-new');
    });
  }
  document.addEventListener('astro:page-load', wireQuips);
</script>

<style>
  .about {
    display: grid;
    gap: 56px;
  }

  /* Who you are ------------------------------------------------------------------------------- */

  .intro {
    display: grid;
    grid-template-columns: 188px minmax(0, 1fr);
    grid-template-areas:
      'mii who'
      'mii ctas';
    align-content: end;
    gap: 0 32px;
  }

  .mii {
    grid-area: mii;
  }

  .who {
    grid-area: who;
    align-self: end;
  }

  .mii {
    position: relative;
    padding-top: 44px;
  }

  .mii :global(.stage) {
    box-shadow: var(--rim);
  }

  /* What the Mii says, in a bubble pointing down at it. */
  .bubble {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 50%;
    width: max-content;
    max-width: 220px;
    margin: 0;
    padding: 6px 12px;
    border-radius: 14px;
    background: var(--color-raise);
    box-shadow:
      var(--rim),
      0 3px 8px -4px rgb(0 0 0 / 0.25);
    color: var(--color-ink-strong);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    translate: -50% 0;
  }

  .bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    background: inherit;
    box-shadow: 1px 1px 0 light-dark(rgb(55 70 78 / 0.2), rgb(0 0 0 / 0.6));
    rotate: 45deg;
    translate: -50% 0;
  }

  .bubble:global(.is-new) {
    animation: pop 0.45s var(--ease-spring);
  }

  @keyframes pop {
    from {
      scale: 0.85;
      opacity: 0.4;
    }
  }

  .name {
    color: var(--color-ink-strong);
    font-size: clamp(2rem, 3.4vw, 2.625rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .role {
    margin-top: 10px;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
  }

  .role a {
    color: var(--color-ink-strong);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(47 178 230 / 0.5);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .headline {
    margin-top: 4px;
    color: var(--color-ink);
    font-size: 1.0625rem;
    text-wrap: balance;
  }

  .ctas {
    grid-area: ctas;
    display: flex;
    flex-wrap: wrap;
    align-self: start;
    gap: 10px;
    margin: 20px 0 6px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 20px 0 16px;
    border-radius: 22px;
    background: linear-gradient(to bottom, var(--color-gloss-top), var(--color-gloss-bottom));
    box-shadow:
      var(--rim),
      0 2px 6px -3px rgb(0 0 0 / 0.3);
    color: var(--color-ink-strong);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: scale 0.25s var(--ease-spring);
  }

  .cta-go {
    background: linear-gradient(to bottom, #86d84c, var(--color-leaf-deep));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 0 0 1px rgb(40 110 10 / 0.5),
      0 3px 8px -4px rgb(40 110 10 / 0.6);
    color: #fff;
    text-shadow: 0 1px 1px rgb(20 70 0 / 0.35);
  }

  .cta:hover {
    scale: 1.03;
  }

  .cta:active {
    scale: 0.97;
  }

  .cta:focus-visible {
    outline: none;
    box-shadow: var(--glow);
  }

  /* The story's headings and the sections' match. */
  .story :global(h2),
  .section-head {
    margin: 0 0 14px;
    color: var(--color-ink-strong);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .story :global(h2) {
    margin-top: 40px;
  }

  /* Work: a row each, under a hairline ------------------------------------------------------------ */

  .work {
    border-top: 1px solid var(--color-line);
  }

  .work li {
    display: grid;
    grid-template-columns: 104px auto minmax(0, 1fr);
    align-items: start;
    gap: 0 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .years {
    padding-top: 7px;
    color: var(--color-ink-soft);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .work :global(.link-badge) {
    width: 34px;
    height: 34px;
    border-radius: 10px;
  }

  .work :global(.logo) {
    display: block;
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  /* A dark logo keeps its edge against the night. */
  :global(:root[data-theme='dark']) .work :global(.logo) {
    filter: drop-shadow(0 0 0.6px rgb(255 255 255 / 0.55));
  }

  :global(:root[data-theme='dark']) .work :global(.logo.mono) {
    filter: invert(1);
  }

  .title {
    color: var(--color-ink-strong);
    font-weight: 700;
    line-height: 1.4;
  }

  .at {
    margin: 0 0.3em;
    color: var(--color-ink-soft);
    font-weight: 400;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-color: rgb(47 178 230 / 0.5);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .summary {
    margin-top: 3px;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .more {
    display: inline-block;
    margin-top: 16px;
    color: var(--color-ink-strong);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(47 178 230 / 0.5);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* Socials ------------------------------------------------------------------------------------- */

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .socials a:hover span {
    color: var(--color-ink-strong);
    text-decoration: underline;
    text-decoration-color: rgb(47 178 230 / 0.5);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .socials :global(.link-badge) {
    width: 26px;
    height: 26px;
    border-radius: 8px;
  }

  .socials :global(.link-badge:not(.is-bleed) svg) {
    width: 15px;
    height: 15px;
  }

  /* A phone ----------------------------------------------------------------------------------- */

  @media (max-width: 560px) {
    .about {
      gap: 44px;
    }

    .intro {
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-areas:
        'mii who'
        'ctas ctas';
      gap: 0 18px;
    }

    .who {
      align-self: center;
    }

    .cta {
      flex: 1;
      justify-content: center;
    }

    .mii {
      padding-top: 0;
    }

    .bubble {
      display: none;
    }

    .role,
    .headline {
      font-size: 0.9375rem;
    }

    .work li {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2px 12px;
    }

    .years {
      grid-column: 2;
      grid-row: 1;
      padding-top: 0;
      font-size: 0.8125rem;
    }

    .work :global(.link-badge),
    .work :global(.logo) {
      grid-column: 1;
      grid-row: 1 / span 2;
      margin-top: 2px;
    }

    .job {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble:global(.is-new) {
      animation: none;
    }
  }
</style>
