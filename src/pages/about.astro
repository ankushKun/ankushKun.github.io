---
import { render } from 'astro:content';
import Page from '../layouts/Page.astro';
import Panel from '../components/ui/Panel.astro';
import MenuButton from '../components/ui/MenuButton.astro';
import Friends from '../components/Friends.astro';
import MiiStage from '../components/mii/Stage.astro';
import { AUTHOR } from '../site';
import { resume } from '../data/resume';
import { formatMonth, getPage } from '../lib/content';

const { Content } = await render(await getPage('about'));

// Time in each role, as the console shows play time: a bar each, the longest one full.
const months = (start: string, end?: string) => {
  const [y1, m1] = start.split('-').map(Number);
  const now = new Date();
  const [y2, m2] = end ? end.split('-').map(Number) : [now.getUTCFullYear(), now.getUTCMonth() + 1];
  return Math.max(1, (y2 - y1) * 12 + (m2 - m1) + 1);
};
const span = (n: number) => [Math.floor(n / 12) && `${Math.floor(n / 12)} yr`, n % 12 && `${n % 12} mo`].filter(Boolean).join(' ');
const roles = resume.experience.map((e) => ({ ...e, months: months(e.start, e.end) }));
const longest = Math.max(...roles.map((r) => r.months));
---

<Page id="about" pageType="ProfilePage" type="profile" layout="bare">
  <div class="about">
    <Panel class="profile">
      <div class="me">
        <MiiStage />
        <div class="card">
          <h2>{AUTHOR.name}</h2>
          <p class="role">{AUTHOR.jobTitle}, <a href={AUTHOR.worksFor.url}>{AUTHOR.worksFor.name}</a></p>
          <ul class="facts">
            <li class="chip">{AUTHOR.location}</li>
            {AUTHOR.alternateName.slice(1).map((n) => <li class="chip">{n}</li>)}
          </ul>
          <div class="menu">
            <MenuButton href="/projects/" label="Projects" icon="grid" />
            <MenuButton href="/blogs/" label="Posts" icon="post" />
            <MenuButton href="/contact/" label="Say hello" icon="mail" go />
          </div>
        </div>
      </div>
    </Panel>

    <Panel>
      <div class="prose">
        <Content />
      </div>
    </Panel>

    <Panel title="Play activity">
      <ol class="activity">
        {
          roles.map((r, i) => (
            <li style={`--w:${(r.months / longest) * 100}%;--i:${i}`}>
              <div class="row">
                <span class="what">
                  <strong>{r.org}</strong>
                  <span>{r.role}</span>
                </span>
                <span class="when">
                  {formatMonth(r.start)} to {formatMonth(r.end)}
                </span>
              </div>
              <div class:list={['track', { now: !r.end }]}>
                <span class="fill" />
                <span class="time">{span(r.months)}</span>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="more">
        <MenuButton href="/resume/" label="Resume" icon="doc" />
      </div>
    </Panel>

    <Panel title="Friends">
      <Friends />
    </Panel>
  </div>
</Page>

<style>
  .me {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: center;
    gap: 28px;
  }

  .card h2 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .role {
    margin-top: 4px;
    color: var(--color-ink-soft);
  }

  .role a {
    color: var(--color-ink-strong);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(47 178 230 / 0.5);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .menu {
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }

  .activity {
    display: grid;
    gap: 20px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
  }

  .what {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
    align-items: baseline;
  }

  .what strong {
    color: var(--color-ink-strong);
    font-weight: 800;
  }

  .what span,
  .when {
    color: var(--color-ink-soft);
    font-size: 0.875rem;
  }

  .track {
    position: relative;
    display: flex;
    align-items: center;
    height: 22px;
    margin-top: 8px;
    border-radius: 99px;
    background: linear-gradient(to bottom, light-dark(#e4e7e9, #171b1e), light-dark(#eef0f1, #1f2427));
    box-shadow: inset 0 1px 3px light-dark(rgb(0 0 0 / 0.1), rgb(0 0 0 / 0.5));
  }

  .fill {
    width: var(--w);
    min-width: 22px;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(to bottom, #86d84c, var(--color-leaf-deep));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      inset 0 -2px 0 rgb(0 0 0 / 0.1);
    transform-origin: left;
    animation: grow 1.1s var(--ease-glide) both;
    animation-delay: calc(var(--i) * 90ms + 200ms);
  }

  /* Still playing: the bar is lit and moving. */
  .now .fill {
    background:
      repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.22) 0 8px, transparent 8px 16px),
      linear-gradient(to bottom, #6fd2ff, #1f96d6);
    background-size:
      22.6px 22px,
      100% 100%;
    animation:
      grow 1.1s var(--ease-glide) both,
      march 1.2s linear infinite;
    animation-delay: 200ms, 0s;
  }

  .time {
    position: absolute;
    right: 10px;
    color: var(--color-ink-soft);
    font-size: 0.75rem;
    font-weight: 700;
  }

  @keyframes grow {
    from {
      scale: 0 1;
    }
  }

  @keyframes march {
    to {
      background-position:
        22.6px 0,
        0 0;
    }
  }

  .more {
    display: flex;
    margin-top: 26px;
  }

  @media (max-width: 559px) {
    .me {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    .me :global(.stage) {
      max-width: 240px;
      margin: 0 auto;
    }

    .card {
      text-align: center;
    }

    .facts {
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fill,
    .now .fill {
      animation: none;
    }
  }
</style>
