---
import Entry from '../../layouts/Entry.astro';
import MenuButton from '../../components/ui/MenuButton.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEntries('consoles')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<Entry entry={entry}>
  <div slot="meta" class="meta">
    <ul class="facts">
      <li class="pill">{data.maker}</li>
      <li class="chip">Released {data.released}</li>
      {data.mods.map((m) => <li class="chip">{m}</li>)}
    </ul>
    {
      data.links.length > 0 && (
        <div class="links">
          {data.links.map((l) => (
            <MenuButton href={l.url} label={l.label} />
          ))}
        </div>
      )
    }
  </div>
</Entry>

<style>
  .meta {
    display: grid;
    gap: 16px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
</style>
