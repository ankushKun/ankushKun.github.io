---
import Page from '../layouts/Page.astro';
import { APPS } from '../data/apps';
import { channelFor } from '../lib/tiles';

// The Wii's channel menu: each app a wide channel in a glossy frame, its art edge to edge and its
// name across the top; the menu is always whole pages of twelve, the slots no app has yet shown as
// grey empty channels. The grid is two, three or four channels across, by the room it has. An app
// without an address isn't ready: pressing it shakes its head. One that is grows from its channel
// to fill the screen, and shrinks back into it on the way out (data-grow, src/scripts/motion.ts).
const PAGE = 12;
const channels = APPS.map((app) => {
  const art = channelFor(`/apps/#${app.id}`)?.src;
  return { ...app, art, painted: art?.endsWith('.webp') };
});
const empty = Math.ceil(Math.max(channels.length, 1) / PAGE) * PAGE - channels.length;
---

<Page id="apps" pageType="CollectionPage" layout="menu">
  <div class="menu">
    <ul class="grid">
      {
        channels.map((app) => (
          <li id={app.id}>
            {app.href ? (
              <a href={app.href} class:list={['channel', app.painted && 'is-painted']} data-grow data-sfx>
                {app.art && <img class="art" src={app.art} alt="" width="560" height="315" decoding="async" />}
                <span class="name">{app.label}</span>
              </a>
            ) : (
              <button type="button" class:list={['channel', app.painted && 'is-painted']} aria-disabled="true" aria-describedby={`${app.id}-desc`} data-sfx="nope">
                {app.art && <img class="art" src={app.art} alt="" width="560" height="315" decoding="async" />}
                <span class="name">{app.label}</span>
                <span id={`${app.id}-desc`} class="sr-only">
                  {app.description} Not ready yet.
                </span>
              </button>
            )}
          </li>
        ))
      }
      {Array.from({ length: empty }, () => <li class="slot" aria-hidden="true"><span /></li>)}
    </ul>
  </div>
</Page>

<script>
  // An app that isn't ready shakes its head.
  document.addEventListener('click', (e) => {
    const app = e.target instanceof Element ? e.target.closest<HTMLElement>('.channel[aria-disabled="true"]') : null;
    if (!app || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    app.animate([{ translate: '0' }, { translate: '-7px 0' }, { translate: '7px 0' }, { translate: '-5px 0' }, { translate: '4px 0' }, { translate: '0' }], { duration: 420, easing: 'ease-out' });
  });
</script>

<style>
  /* Columns follow the room the menu has, not the window. */
  .menu {
    container-type: inline-size;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 540px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container (min-width: 780px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  li {
    scroll-margin-top: 40px;
  }

  /* A channel: wide, in a glossy white frame, with a sheen across the top of its glass. */
  .channel,
  .slot {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 4px;
    border: 0;
    border-radius: 18px;
    background: linear-gradient(to bottom, var(--color-gloss-top), var(--color-gloss-bottom));
    box-shadow:
      inset 0 0 0 1px light-dark(rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.08)),
      0 0 0 1px light-dark(rgb(40 60 70 / 0.16), rgb(0 0 0 / 0.6)),
      0 4px 10px -5px light-dark(rgb(30 50 60 / 0.3), rgb(0 0 0 / 0.6));
  }

  .channel {
    container-type: inline-size;
    color: #fff;
    font: inherit;
    text-decoration: none;
    transition:
      box-shadow 0.18s ease,
      scale 0.35s var(--ease-spring);
  }

  .channel::after {
    content: '';
    position: absolute;
    inset: 4px 4px 50%;
    border-radius: 14px 14px 40% 40% / 14px 14px 18% 18%;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.32), rgb(255 255 255 / 0.04));
    pointer-events: none;
  }

  .channel:hover,
  .channel:focus-visible {
    scale: 1.04;
    box-shadow:
      var(--glow),
      0 10px 20px -8px light-dark(rgb(30 50 60 / 0.4), rgb(0 0 0 / 0.6));
  }

  .channel:active {
    scale: 0.98;
    transition-duration: 0.08s;
  }

  .art {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 14px;
    object-fit: cover;
  }

  /* Painted art is busy, so a soft shade at its top keeps the name readable. */
  .is-painted::before {
    content: '';
    position: absolute;
    inset: 4px 4px 50%;
    border-radius: 14px 14px 0 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.42), transparent);
    pointer-events: none;
  }

  /* The name across the top, white with a soft dark edge, as the Wii lettered its channels. */
  .name {
    position: absolute;
    top: 9%;
    right: 8px;
    left: 8px;
    overflow: hidden;
    font-size: clamp(0.75rem, 8.5cqi, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    text-align: center;
    text-overflow: ellipsis;
    text-shadow:
      0 0 2px rgb(0 0 0 / 0.55),
      0 1px 3px rgb(0 0 0 / 0.45);
    white-space: nowrap;
  }

  /* A slot with no channel yet: grey, finely striped, softly lit from inside. */
  .slot span {
    display: block;
    height: 100%;
    border-radius: 14px;
    background: repeating-linear-gradient(
      to bottom,
      light-dark(#eef0f1, #262c30) 0 2px,
      light-dark(#e4e7e9, #22282b) 2px 4px
    );
    box-shadow: inset 0 0 22px light-dark(rgb(255 255 255 / 0.85), rgb(0 0 0 / 0.35));
  }

  /* Arriving from its block on the plaza, an app says hello. */
  li:target .channel {
    animation: hello 1.1s var(--ease-spring) 0.5s both;
  }

  @keyframes hello {
    30% {
      scale: 1.1;
    }
    55% {
      scale: 0.97;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    li:target .channel {
      animation: none;
    }
  }
</style>
