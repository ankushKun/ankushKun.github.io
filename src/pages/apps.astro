---
import Page from '../layouts/Page.astro';
import ChannelGrid from '../components/ChannelGrid.astro';
import { APPS, appPath } from '../data/apps';
import { channelFor } from '../lib/tiles';

const channels = APPS.map((app) => {
  const ch = channelFor(appPath(app));
  return { ...app, art: ch?.src, banner: ch?.banner, live: Boolean(app.href) && !app.soon, grow: app.href?.startsWith('/apps/') };
});
const live = APPS.filter((a) => a.href && !a.soon).map((a) => a.label);
const listed = live.length > 1 ? `${live.slice(0, -1).join(', ')} and ${live.at(-1)}` : live[0];
---

<Page id="apps" pageType="CollectionPage" layout="menu">
  <ChannelGrid
    {channels}
    hint={{ title: 'Pick a channel!', text: `${listed} ${live.length > 1 ? 'are' : 'is'} live right now. Point at any channel to see what it does.` }}
  />
</Page>
