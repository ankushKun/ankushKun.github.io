---
import Page from '../../layouts/Page.astro';
import ChannelMenu from '../../components/ChannelMenu.astro';
import { getEntries } from '../../lib/content';

const talks = await getEntries('talks');
---

<Page id="talks" pageType="CollectionPage" layout="menu">
  <ChannelMenu items={talks} play={(e) => e.collection === 'talks' && Boolean(e.data.video)} />
</Page>
