---
import Page from '../layouts/Page.astro';
import MenuButton from '../components/ui/MenuButton.astro';
import Friends from '../components/Friends.astro';
import { AUTHOR, BOOKING_URL } from '../site';
---

<Page id="contact" pageType="ContactPage">
  <div class="mail">
    <MenuButton href={`mailto:${AUTHOR.email}`} label="Write a letter" sub={AUTHOR.email} icon="mail" go />
    <MenuButton href={BOOKING_URL} label="Book a call" sub="cal.com" icon="phone" />
  </div>
  <h2 class="panel-head">Friends</h2>
  <Friends />
</Page>

<style>
  .mail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    margin: 2rem 0 2.5rem;
  }

</style>
