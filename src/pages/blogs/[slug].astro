---
import Entry from '../../layouts/Entry.astro';
import MenuButton from '../../components/ui/MenuButton.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEntries('blog')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<Entry entry={entry}>
  {
    data.links.length > 0 && (
      <div slot="meta" class="links">
        {data.links.map((l) => (
          <MenuButton href={l.url} label={l.label} />
        ))}
      </div>
    )
  }
</Entry>

<style>
  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
    gap: 10px;
  }
</style>
