---
import Entry from '../../layouts/Entry.astro';
import { getEntries } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEntries('blog')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<Entry entry={entry}>
  {data.links.length > 0 && (
    <ul slot="meta" class="flex flex-wrap gap-4 text-sm">
      {data.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
    </ul>
  )}
</Entry>
