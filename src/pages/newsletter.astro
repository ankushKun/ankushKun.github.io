---
import Page from '../layouts/Page.astro';
import MenuButton from '../components/ui/MenuButton.astro';
import { NEWSLETTER } from '../site';
---

<Page id="newsletter">
  {
    NEWSLETTER.action ? (
      <form action={NEWSLETTER.action} method="post" class="form" data-astro-reload>
        <label for="newsletter-email" class="sr-only">
          Email
        </label>
        <input id="newsletter-email" type="email" name={NEWSLETTER.emailField} required autocomplete="email" placeholder="you@example.com" />
        <button type="submit" class="b-btn" data-sfx>
          Subscribe
        </button>
      </form>
    ) : (
      <div class="pending">
        <aside class="mii-note">
          <img src="/mii/me-surprised.webp" alt="" width="112" height="112" decoding="async" />
          <div class="bubble">
            <strong>Email dispatches are still being wired up!</strong> Until SpotPass email lands, grab the RSS feed so you never miss a post, or drop into Chat.
          </div>
        </aside>
        <div class="actions">
          <MenuButton href="/blogs/index.xml" label="Subscribe via RSS" />
          <MenuButton href="/apps/chat/" label="Join #general Chat" />
          <MenuButton href="/contact/" label="Send a note" />
        </div>
      </div>
    )
  }
</Page>

<style>
  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 1.5rem;
  }

  input {
    flex: 1 1 240px;
    min-width: 0;
    height: 46px;
    padding: 0 1.1em;
    border: 0;
    border-radius: 14px;
    background: var(--color-raise);
    box-shadow:
      var(--rim),
      inset 0 2px 4px light-dark(rgb(0 30 40 / 0.07), rgb(0 0 0 / 0.3));
    color: var(--color-ink-strong);
    font: inherit;
  }

  input:focus-visible {
    box-shadow: var(--glow);
  }

  .pending {
    display: grid;
    gap: 18px;
    margin-top: 1.75rem;
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 12px;
  }
</style>
