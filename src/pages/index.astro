---
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/content';
import { ogAlt, ogPathForPage } from '../lib/og';
import { SITE } from '../site';
import { PERSON_ID, webPage } from '../lib/schema';

// The plaza itself is part of every page (Base.astro); on this one it is the page.
const page = await getPage('home');
const { title, description, cover, updated } = page.data;
---

<Base
  {title}
  {description}
  image={cover}
  imageUrl={cover ? undefined : ogPathForPage('home')}
  imageAlt={cover ? undefined : ogAlt(SITE.title)}
  video={{ url: '/media/plaza-preview.mp4', width: 1200, height: 630 }}
  type="profile"
  modified={updated}
  fullscreen
  schema={[webPage('ProfilePage', '/', title, description, { mainEntity: { '@id': PERSON_ID } })]}
/>
