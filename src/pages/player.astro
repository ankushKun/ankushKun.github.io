---
// The plaza, live, for X to play inside a post (twitter:player). The share link /x/ names it, so a
// post linking ankush.one/x/ plays it. Links open the site in a new tab; the home page is the one to
// index.
import Base from '../layouts/Base.astro';
import { absUrl, getPage } from '../lib/content';

const { title, description } = (await getPage('home')).data;
---

<Base {title} {description} canonical={absUrl('/')} embed noindex />
