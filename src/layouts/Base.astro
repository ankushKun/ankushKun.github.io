---
// Page shell: every meta tag, Open Graph, JSON-LD, header and footer live here.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { AUTHOR, FOOTER_NAV, NAV, SITE } from '../site';
import { absUrl } from '../lib/content';
import { OG_HEIGHT, OG_WIDTH, ogPathForPage } from '../lib/og';
import { person, website } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageUrl?: string;
  imageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Fullscreen stage mode (home page WaraWara Plaza): no header, nav, footer, or scroll sections. */
  fullscreen?: boolean;
}

const {
  title,
  description,
  image,
  imageUrl,
  imageAlt = '',
  canonical: canonicalOverride,
  type = 'website',
  published,
  modified,
  schema = [],
  noindex = false,
  fullscreen = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? `${SITE.title} | ${AUTHOR.jobTitle}` : `${title} | ${SITE.title}`;
const pageUrl = absUrl(Astro.url.pathname);
const canonical = canonicalOverride ?? pageUrl;

let ogUrl: string;
let ogWidth = OG_WIDTH;
let ogHeight = OG_HEIGHT;

if (image) {
  const og = await getImage({ src: image, width: OG_WIDTH, height: OG_HEIGHT, format: 'jpg' });
  ogUrl = absUrl(og.src);
  ogWidth = Number(og.attributes.width ?? OG_WIDTH);
  ogHeight = Number(og.attributes.height ?? OG_HEIGHT);
} else {
  ogUrl = absUrl(imageUrl ?? ogPathForPage('home'));
}

const jsonLd = { '@context': 'https://schema.org', '@graph': [website(), person(), ...schema] };
const current = (href: string) => Astro.url.pathname.startsWith(href);
const hero = !fullscreen && Astro.slots.has('hero') ? (await Astro.slots.render('hero')).trim() : '';
const hasHero = hero !== '';
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} blog`} href="/blogs/index.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={absUrl('/about/')} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class:list={[fullscreen && 'm-0 h-svh overflow-hidden']}>
    {
      fullscreen ? (
        <main class="h-svh w-full overflow-hidden">
          <slot />
        </main>
      ) : (
        <>
          <div class:list={[hasHero && 'relative']}>
            <header
              data-site-header
              class:list={[
                'mx-auto flex max-w-2xl flex-wrap justify-between gap-4 px-4 pt-8',
                hasHero ? 'pointer-events-none absolute inset-x-0 top-0 z-10 [&_a]:pointer-events-auto' : 'mb-12',
              ]}
            >
              <a href="/" class="font-semibold">{SITE.title}</a>
              <nav class="flex flex-wrap gap-4">
                {NAV.map((l) => <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>)}
              </nav>
            </header>
            {hasHero && <Fragment set:html={hero} />}
          </div>

          <div class:list={['mx-auto max-w-2xl px-4 pb-8', hasHero && 'pt-12']}>
            <main>
              <slot />
            </main>

            <footer class="mt-16 flex flex-wrap gap-4 border-t pt-4 text-sm">
              <span>&copy; {new Date().getFullYear()} {AUTHOR.name}</span>
              {FOOTER_NAV.map((l) => <a href={l.href}>{l.label}</a>)}
            </footer>
          </div>
        </>
      )
    }
  </body>
</html>
