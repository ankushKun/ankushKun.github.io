---
// Page shell: every meta tag, Open Graph, JSON-LD, and the screen every page sits on. The home page
// is the plaza and nothing else. Every other page is shown on the TV (Frame.astro): one column to
// read down the middle of the screen, the site's other pages in its footer. Pages on the TV change
// in place through Astro's router (src/scripts/motion.ts); to and from the plaza is a real page
// load, so the plaza only ever runs while you are on it. On a big screen the next one is
// prerendered as the pointer rests on its way there, so even that starts the moment you click.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@fontsource/m-plus-1p/latin-300.css';
import '@fontsource/m-plus-1p/latin-400.css';
import '@fontsource/m-plus-1p/latin-500.css';
import '@fontsource/m-plus-1p/latin-700.css';
import '@fontsource/m-plus-1p/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import { AUTHOR, FOOTER_NAV, SITE } from '../site';
import { absUrl, pagePath } from '../lib/content';
import { OG_HEIGHT, OG_WIDTH, ogPathForPage } from '../lib/og';
import { person, website } from '../lib/schema';
import { tileFor } from '../lib/tiles';
import Frame from '../components/ui/Frame.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import Plaza from '../components/plaza/Plaza.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageUrl?: string;
  imageAlt?: string;
  canonical?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** The home page: the plaza is the page, with no TV around it. */
  fullscreen?: boolean;
  /** An app: it fills the TV's whole screen instead of the reading column, with no footer. */
  app?: boolean;
}

const {
  title,
  description,
  image,
  imageUrl,
  imageAlt = '',
  canonical: canonicalOverride,
  type = 'website',
  published,
  modified,
  schema = [],
  noindex = false,
  fullscreen = false,
  app = false,
} = Astro.props;

const path = pagePath(Astro.url);
const isHome = path === '/';
const fullTitle = isHome ? SITE.title : `${title} | ${SITE.title}`;
const pageUrl = absUrl(path);
const canonical = canonicalOverride ?? pageUrl;

let ogUrl: string;
let ogWidth = OG_WIDTH;
let ogHeight = OG_HEIGHT;

if (image) {
  const og = await getImage({ src: image, width: OG_WIDTH, height: OG_HEIGHT, format: 'jpg' });
  ogUrl = absUrl(og.src);
  ogWidth = Number(og.attributes.width ?? OG_WIDTH);
  ogHeight = Number(og.attributes.height ?? OG_HEIGHT);
} else {
  ogUrl = absUrl(imageUrl ?? ogPathForPage('home'));
}

const jsonLd = { '@context': 'https://schema.org', '@graph': [website(), person(), ...schema] };
// The section's two colors tint its pages.
const colors = tileFor(path)?.colors;
const accent = colors ? `--c1:${colors[0]};--c2:${colors[1]}` : undefined;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.lang} data-home={fullscreen ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={fullscreen ? '#e4f0f2' : '#eceff1'} data-light={fullscreen ? '#e4f0f2' : '#eceff1'} data-dark={fullscreen ? '#13171a' : '#0f1214'} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} blog`} href="/blogs/index.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={absUrl('/about/')} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // The lights, set before anything is drawn so a dark page never flashes white: your choice
      // if you have made one, else the device's (src/scripts/theme.ts switches them).
      // A prerendered page reads it again when it is shown, in case it changed meanwhile.
      (function () {
        var html = document.documentElement;
        function apply() {
          var theme;
          try {
            theme = localStorage.getItem('theme');
          } catch (e) {}
          if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          html.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = meta.getAttribute('data-' + theme);
        }
        apply();
        if (document.prerendering) document.addEventListener('prerenderingchange', apply, { once: true });
      })();
    </script>
    <script is:inline>
      // Going between the plaza and the TV is a real page load (the end of global.css). Leaving, the
      // plaza has already zoomed into the block you pressed and faded into its haze (plaza/main.ts),
      // so the page simply fades itself in, as a page opened directly does. Coming back, the page
      // fades away and the plaza pulls back out of the block; meanwhile the column keeps no
      // transition name of its own, so it goes with the whole screen.
      (function () {
        var html = document.documentElement;
        var home = html.hasAttribute('data-home');
        addEventListener('pageswap', function (e) {
          if (e.viewTransition && !home) html.dataset.plazaMove = 'return';
        });
        // A page opened directly (by its address, a refresh, or from another site) fades in on its own.
        function arrive() {
          html.setAttribute('data-arrive', '');
          setTimeout(function () {
            html.removeAttribute('data-arrive');
          }, 1500);
        }
        if (!('onpagereveal' in window)) arrive();
        addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return arrive();
          if (!home) {
            // Skipping a move rejects its promise of being ready; nothing waits on it.
            e.viewTransition.ready.catch(function () {});
            e.viewTransition.skipTransition();
            return arrive();
          }
          html.dataset.plazaMove = 'return';
          e.viewTransition.finished.finally(function () {
            delete html.dataset.plazaMove;
          });
        });
        addEventListener('pageshow', function () {
          delete html.dataset.plazaMove;
        });
      })();
    </script>
    <script is:inline>
      // On a big screen, the way between the plaza and the TV is prerendered while the pointer rests
      // on it: the TV's plaza button, or a block on the plaza. A click then shows a page that is
      // already built, so the move starts at once. Phones and data savers skip it: building the
      // plaza in the background costs a second or two of work.
      (function () {
        var nav = navigator;
        if (!(HTMLScriptElement.supports && HTMLScriptElement.supports('speculationrules'))) return;
        if ((nav.connection && nav.connection.saveData) || (nav.deviceMemory || 8) < 4) return;
        if (!matchMedia('(pointer: fine) and (min-width: 1000px)').matches) return;
        var where = document.documentElement.hasAttribute('data-home') ? '.plaza-links a' : '.tv-home';
        function add() {
          if (document.querySelector('script[data-prerender]')) return;
          var rules = document.createElement('script');
          rules.type = 'speculationrules';
          rules.setAttribute('data-prerender', '');
          rules.textContent = JSON.stringify({ prerender: [{ where: { selector_matches: where }, eagerness: 'moderate' }] });
          document.head.append(rules);
        }
        add();
        // The router keeps only the next page's own head; the rules go back in after every swap.
        document.addEventListener('astro:after-swap', add);
      })();
    </script>
    {!fullscreen && <ClientRouter fallback="swap" />}
  </head>
  <body class:list={[fullscreen && 'm-0 h-svh overflow-hidden']} style={accent}>
    {
      fullscreen ? (
        <>
          <Plaza />
          <ThemeToggle />
          <main id="main" class="sr-only">
            <h1>{SITE.title}</h1>
            <slot />
          </main>
        </>
      ) : (
        <>
          <a class="skip-link b-btn" href="#main">
            Skip to content
          </a>
          <Frame />
          <ThemeToggle />
          {app ? (
            <main id="main" class="col col-app">
              <slot />
            </main>
          ) : (
            <main id="main" class="col">
              <div class="col-body">
                <slot />
              </div>
              <footer class="site-foot">
                <nav aria-label="Pages">
                  {FOOTER_NAV.map((l) => (
                    <a href={l.href} data-astro-reload={l.href.startsWith('/#') ? '' : undefined}>
                      {l.label}
                    </a>
                  ))}
                </nav>
                <span>
                  &copy; {year} {AUTHOR.name}
                </span>
              </footer>
            </main>
          )}
        </>
      )
    }
    <script>
      import '../scripts/sfx';
      import '../scripts/motion';
      import '../scripts/theme';
    </script>
  </body>
</html>

