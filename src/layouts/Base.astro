---
// Page shell: every meta tag, Open Graph, JSON-LD, header and footer live here.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { AUTHOR, FOOTER_NAV, NAV, SITE } from '../site';
import { absUrl } from '../lib/content';
import { person, website } from '../lib/schema';
import defaultImage from '../assets/og-default.png';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image, imageAlt = '', type = 'website', published, modified, schema = [], noindex = false } = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? `${SITE.title} | ${AUTHOR.jobTitle}` : `${title} | ${SITE.title}`;
const canonical = absUrl(Astro.url.pathname);
const og = await getImage({ src: image ?? defaultImage, width: 1200, height: 630, format: 'jpg' });
const ogUrl = absUrl(og.src);
const jsonLd = { '@context': 'https://schema.org', '@graph': [website(), person(), ...schema] };
const current = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} blog`} href="/blogs/index.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={absUrl('/about/')} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="mx-auto max-w-2xl px-4 py-8">
    <header class="mb-12 flex flex-wrap justify-between gap-4">
      <a href="/" class="font-semibold">{SITE.title}</a>
      <nav class="flex flex-wrap gap-4">
        {NAV.map((l) => <a href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a>)}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 flex flex-wrap gap-4 border-t pt-4 text-sm">
      <span>&copy; {new Date().getFullYear()} {AUTHOR.name}</span>
      {FOOTER_NAV.map((l) => <a href={l.href}>{l.label}</a>)}
    </footer>
  </body>
</html>
