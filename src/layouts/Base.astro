---
// Page shell: every meta tag, Open Graph, JSON-LD, and the screen every page sits on. The home page
// is the plaza and nothing else. Every other page is shown on the TV (Frame.astro): one column to
// read down the middle of the screen, the site's other pages in its footer. Every page change, to
// and from the plaza too, happens in place through Astro's router (src/scripts/motion.ts), so the
// site is one document for the whole visit and the radio (src/scripts/music/) never stops. Once
// the plaza has run it is kept, asleep, while you are on the TV: every other page holds a place for
// it (transition:persist).
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '@fontsource/m-plus-1p/latin-300.css';
import '@fontsource/m-plus-1p/latin-400.css';
import '@fontsource/m-plus-1p/latin-500.css';
import '@fontsource/m-plus-1p/latin-700.css';
import '@fontsource/m-plus-1p/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import { AUTHOR, FOOTER_NAV, SITE } from '../site';
import { absUrl, pagePath } from '../lib/content';
import { OG_HEIGHT, OG_WIDTH, ogAlt, ogPathForPage } from '../lib/og';
import { person, website } from '../lib/schema';
import { tileFor } from '../lib/tiles';
import { hasTwin, twinOf } from '../lib/twins';
import Frame from '../components/ui/Frame.astro';
import ThemeToggle from '../components/ui/ThemeToggle.astro';
import Plaza from '../components/plaza/Plaza.astro';
import Lobby from '../components/plaza/Lobby.astro';
import MusicWidget from '../components/music/Widget.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageUrl?: string;
  /** What the preview picture shows. Defaults to a description of the generated card. */
  imageAlt?: string;
  /** A clip that plays in the preview (iMessage loops it in the bubble, Discord plays it over the picture). */
  video?: { url: string; width: number; height: number };
  /** Up to two short facts Slack shows under a link's description, as [label, value]. */
  facts?: [string, string][];
  canonical?: string;
  /** X plays this page inside the post (twitter:card player), its picture the still until pressed. */
  player?: { url: string; width: number; height: number };
  /** Sends whoever opens the page on to this address at once (the /x/ share link). */
  redirect?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** The home page: the plaza is the page, with no TV around it. */
  fullscreen?: boolean;
  /** An app: it fills the TV's whole screen instead of the reading column, with no footer. */
  app?: boolean;
  /**
   * The plaza alone, for another site to frame (the X player, /player/): already settled, and every
   * link opens the site in a new tab rather than inside the frame.
   */
  embed?: boolean;
}

const {
  title,
  description,
  image,
  imageUrl,
  imageAlt,
  video,
  facts = [],
  canonical: canonicalOverride,
  player,
  redirect,
  type = 'website',
  published,
  modified,
  schema = [],
  noindex = false,
  fullscreen: fullscreenProp = false,
  app = false,
  embed = false,
} = Astro.props;
const fullscreen = fullscreenProp || embed;

const path = pagePath(Astro.url);
const isHome = path === '/';
const fullTitle = isHome ? SITE.title : `${title} | ${SITE.title}`;
// The page's Markdown twin, for AI agents to read (src/lib/twins.ts), when it has one.
const twin = !embed && (await hasTwin(path)) ? absUrl(twinOf(path)) : null;
const pageUrl = absUrl(path);
const canonical = canonicalOverride ?? pageUrl;

let ogUrl: string;
let ogWidth = OG_WIDTH;
let ogHeight = OG_HEIGHT;

if (image) {
  const og = await getImage({ src: image, width: OG_WIDTH, height: OG_HEIGHT, format: 'jpg' });
  ogUrl = absUrl(og.src);
  ogWidth = Number(og.attributes.width ?? OG_WIDTH);
  ogHeight = Number(og.attributes.height ?? OG_HEIGHT);
} else {
  ogUrl = absUrl(imageUrl ?? ogPathForPage('home'));
}

const ogAltText = imageAlt || (image ? title : ogAlt(title));

const jsonLd = { '@context': 'https://schema.org', '@graph': [website(), person(), ...schema] };
// The section's two colors tint its pages.
const colors = tileFor(path)?.colors;
const accent = colors ? `--c1:${colors[0]};--c2:${colors[1]}` : undefined;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={SITE.lang} data-home={fullscreen ? '' : undefined} data-embed={embed ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <slot name="head" />
    <meta name="theme-color" content={fullscreen ? '#e4f0f2' : '#eceff1'} data-light={fullscreen ? '#e4f0f2' : '#eceff1'} data-dark={fullscreen ? '#13171a' : '#0f1214'} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    <link rel="canonical" href={canonical} />
    {twin && <link rel="alternate" type="text/markdown" href={twin} title="Markdown" />}
    {noindex && <meta name="robots" content="noindex" />}
    {redirect && <meta http-equiv="refresh" content={`0; url=${redirect}`} />}
    <meta name="generator" content={Astro.generator} />
    {embed && <base target="_blank" />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} blog`} href="/blogs/index.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta property="og:type" content={video ? 'video.other' : type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    {/\.jpe?g$/.test(ogUrl) && <meta property="og:image:type" content="image/jpeg" />}
    <meta property="og:image:alt" content={ogAltText} />
    {
      video && (
        <>
          <meta property="og:video" content={absUrl(video.url)} />
          <meta property="og:video:secure_url" content={absUrl(video.url)} />
          <meta property="og:video:type" content="video/mp4" />
          <meta property="og:video:width" content={String(video.width)} />
          <meta property="og:video:height" content={String(video.height)} />
        </>
      )
    }
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={absUrl('/about/')} />}

    <meta name="twitter:card" content={player ? 'player' : 'summary_large_image'} />
    {
      player && (
        <>
          <meta name="twitter:player" content={absUrl(player.url)} />
          <meta name="twitter:player:width" content={String(player.width)} />
          <meta name="twitter:player:height" content={String(player.height)} />
        </>
      )
    }
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAltText} />
    {
      facts.slice(0, 2).map(([label, value], i) => (
        <>
          <meta name={`twitter:label${i + 1}`} content={label} />
          <meta name={`twitter:data${i + 1}`} content={value} />
        </>
      ))
    }

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // The lights, set before anything is drawn so a dark page never flashes white: your choice
      // if you have made one, else light (src/scripts/theme.ts switches them).
      // A prerendered page reads it again when it is shown, in case it changed meanwhile.
      (function () {
        var html = document.documentElement;
        function apply() {
          var theme;
          try {
            theme = localStorage.getItem('theme');
          } catch (e) {}
          if (theme !== 'dark') theme = 'light';
          html.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = meta.getAttribute('data-' + theme);
        }
        apply();
        if (document.prerendering) document.addEventListener('prerenderingchange', apply, { once: true });
      })();
    </script>
    <script is:inline>
      // A page opened directly (by its address, a refresh, or from another site) fades in on its own.
      // Every move within the site is the router's (src/scripts/motion.ts).
      (function () {
        var html = document.documentElement;
        function arrive() {
          html.setAttribute('data-arrive', '');
          setTimeout(function () {
            html.removeAttribute('data-arrive');
          }, 1500);
        }
        if (!('onpagereveal' in window)) arrive();
        addEventListener('pagereveal', function (e) {
          if (e.viewTransition) {
            // Skipping a move rejects its promise of being ready; nothing waits on it.
            e.viewTransition.ready.catch(function () {});
            e.viewTransition.skipTransition();
          }
          arrive();
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={[fullscreen && 'm-0 h-svh overflow-hidden']} style={accent}>
    {
      fullscreen ? (
        <>
          <Plaza />
          <ThemeToggle />
          <MusicWidget />
          <Lobby>
            <slot />
          </Lobby>
        </>
      ) : (
        <>
          <a class="skip-link b-btn" href="#main">
            Skip to content
          </a>
          <Frame />
          <ThemeToggle />
          <MusicWidget />
          <section class="plaza" data-plaza transition:persist="plaza" />
          {app ? (
            <main id="main" class="col col-app">
              <slot />
            </main>
          ) : (
            <main id="main" class="col">
              <div class="col-body">
                <slot />
              </div>
              <footer class="site-foot">
                <nav aria-label="Pages">
                  {FOOTER_NAV.map((l) => (
                    <a href={l.href}>
                      {l.label}
                    </a>
                  ))}
                </nav>
                <span>
                  &copy; {year} {AUTHOR.name}
                </span>
              </footer>
            </main>
          )}
        </>
      )
    }
    <script>
      import '../scripts/analytics';
      import '../scripts/sfx';
      import '../scripts/motion';
      import '../scripts/theme';
      import '../scripts/embeds';
    </script>
  </body>
</html>

