---
// Detail page for any dated entry, to read down the TV's column: the B button back to its section,
// the title, a byline signed by your Mii, the entry's picture, then its text. Section specific
// details (links, stack, where) go in the "meta" slot, extra content after the body in the default
// slot.
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from './Base.astro';
import ChannelMenu from '../components/ChannelMenu.astro';
import Thumb from '../components/ui/Thumb.astro';
import BackButton from '../components/ui/BackButton.astro';
import CautionTape from '../components/ui/CautionTape.astro';
import { NEW_TAB, extAttrs } from '../lib/external';
import { AUTHOR } from '../site';
import { SECTION_PATH, absUrl, formatDate, getPage, getReadMore, isoDate, pagePath, readingMinutes, type Entry } from '../lib/content';
import { inline } from '../lib/inline';
import { OG_HEIGHT, OG_WIDTH, ogPathForEntry } from '../lib/og';
import { breadcrumbs, entryNode, faqPage } from '../lib/schema';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { data } = entry;
const post = entry.collection === 'blog';
const hero = entry.collection !== 'timeline' || Boolean(data.cover);
const archived = entry.collection === 'projects' && entry.data.status === 'archived';
// A short entry with no picture above or in its text has Related in view as the page opens, so its
// first row (two across) loads at once; anywhere else Related is further down and its pictures wait.
const body = entry.body ?? '';
const relatedInView = !hero && !/<iframe|<img|!\[/.test(body) && body.trim().length < 520;
const { Content } = await render(entry);
const section = await getPage(entry.collection);
const sectionPath = SECTION_PATH[entry.collection];
const sectionTitle = section.data.title;

const generatedOgPath = data.cover ? undefined : ogPathForEntry(entry);
const schemaImage = data.cover
  ? absUrl((await getImage({ src: data.cover, width: OG_WIDTH, height: OG_HEIGHT, format: 'jpg' })).src)
  : absUrl(generatedOgPath!);

const canonicalHost = data.canonical ? new URL(data.canonical).hostname.replace(/^www\./, '') : undefined;

const readMoreEntries = await getReadMore(entry, 4);

const schemaNodes = [
  entryNode(entry, schemaImage),
  breadcrumbs([
    { name: sectionTitle, path: sectionPath },
    { name: data.title, path: pagePath(Astro.url) },
  ]),
  ...(data.faq.length > 0 ? [faqPage(data.faq)] : []),
];
---

<Base
  title={data.title}
  description={data.description}
  image={data.cover}
  imageUrl={generatedOgPath}
  imageAlt={data.coverAlt || data.title}
  canonical={data.canonical}
  type="article"
  published={data.date}
  modified={data.updated}
  schema={schemaNodes}
>
  <article>
    {archived && <CautionTape corner />}
    <BackButton href={sectionPath} label={sectionTitle} tile={sectionPath} />
    <h1>{data.title}</h1>
    <p class="byline">
      <img src="/mii/me.webp" alt="" width="64" height="64" />
      <span class="who">{AUTHOR.name.split(' ')[0]}</span>
      <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
      {post && <span>{readingMinutes(entry)} min read</span>}
      {
        data.updated && (
          <span>
            Updated <time datetime={isoDate(data.updated)}>{formatDate(data.updated)}</time>
          </span>
        )
      }
      {
        data.canonical && canonicalHost && (
          <span>
            First on{' '}
            <a href={data.canonical} class="ext" {...extAttrs(data.canonical)}>
              {canonicalHost}
              <span class="sr-only">{NEW_TAB}</span>
            </a>
          </span>
        )
      }
    </p>
    {!post && <p class="lead">{data.description}</p>}
    {
      hero && (
        <div class="hero">
          <Thumb {entry} main eager width={1280} class="cover" />
          {archived && <CautionTape />}
        </div>
      )
    }
    {
      Astro.slots.has('meta') && (
        <div class="meta">
          <slot name="meta" />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <slot />

    {
      data.tags.length > 0 && (
        <ul class="tags">
          {data.tags.map((t) => (
            <li class="chip">{t.replace(/-/g, ' ')}</li>
          ))}
        </ul>
      )
    }

    {
      data.faq.length > 0 && (
        <section class="faq">
          <h2>Frequently asked questions</h2>
          <dl>
            {data.faq.map((item) => (
              <div>
                <dt>{item.q}</dt>
                <dd set:html={inline(item.a)} />
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      readMoreEntries.length > 0 && (
        <section class="related">
          <h2>Read more</h2>
          <ChannelMenu items={readMoreEntries} eager={relatedInView ? 2 : 0} showKind />
        </section>
      )
    }

    <aside class="mii-note signoff" aria-label="Say hello">
      <img src="/mii/me-happy.webp" alt="" width="112" height="112" loading="lazy" decoding="async" />
      <div class="bubble">
        <p>
          <strong>Thanks for reading!</strong> Got thoughts, questions, or a weird bug to trade? Drop by the{' '}
          <a href="/apps/chat/">live Miiverse chat</a>, subscribe via <a href="/blogs/index.xml">RSS</a>, or{' '}
          <a href="/contact/">send a note</a>.
        </p>
      </div>
    </aside>
  </article>
</Base>

<style>
  /* An entry reads at a comfortable measure, centered on the column however wide it is. */
  article {
    max-width: 44rem;
    margin-inline: auto;
  }

  h1 {
    margin-top: 22px;
    font-size: clamp(1.75rem, 1.35rem + 1.8vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.16;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    margin-top: 16px;
    color: var(--color-ink-quiet);
    font-size: 0.875rem;
  }

  .byline img {
    width: 28px;
    height: 28px;
    margin-right: -4px;
    border-radius: 50%;
    background: light-dark(#e3f1f6, #2c3a40);
  }

  .who {
    color: var(--color-ink);
    font-weight: 700;
  }

  .byline a {
    text-decoration: underline;
    text-decoration-color: light-dark(rgb(55 70 78 / 0.3), rgb(255 255 255 / 0.3));
    text-underline-offset: 2px;
  }

  .lead {
    margin-top: 16px;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .hero {
    position: relative;
    margin-top: 28px;
    overflow: hidden;
    border-radius: 14px;
  }

  article :global(.cover) {
    aspect-ratio: 16 / 9;
  }

  .meta {
    margin-top: 28px;
  }

  .prose {
    margin-top: 30px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2.5rem;
  }

  .faq,
  .related {
    margin-top: 3.5rem;
  }

  /* Keep the 4-item Read more shelf a clean 2x2 grid inside the 44rem article column. */
  .related :global(.channels) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .faq h2,
  .related h2 {
    margin-bottom: 1.1rem;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .faq dl {
    display: grid;
    gap: 1.1rem;
  }

  .faq dt {
    font-weight: 700;
  }

  .faq dd {
    margin-top: 4px;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  .faq dd :global(a),
  .signoff a {
    color: var(--color-ink-strong);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgb(47 178 230 / 0.55);
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .signoff {
    margin-top: 3.5rem;
  }
</style>
